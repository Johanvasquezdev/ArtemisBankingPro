{
  "JWT": {
    "Key": "REPLACE_WITH_USER_SECRET",
    "Issuer": "ArtemisBank.API",
    "Audience": "ArtemisBank.Client",
    "DurationInMinutes": "30"
  },
  "UseInMemoryDatabase": false,
  "EnableSensitiveDataLogging": false,
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_USER_SECRET",
    "IdentityConnection": "REPLACE_WITH_USER_SECRET", "AzureWebJobsStorage": "UseDevelopmentStorage=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/abp-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "REPLACE_WITH_USER_SECRET",
    "SmtpPassword": "REPLACE_WITH_USER_SECRET",
    "FromEmail": "NoReply@ArtemisBank.com",
    "FromName": "Artemis Banking Pro",
    "UseSsl": true
  },
  "AllowedHosts": "*"
}
