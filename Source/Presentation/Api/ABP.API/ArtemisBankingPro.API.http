@host = https://localhost:7073
@contentType = application/json

### 1) LOGIN
# Esperado: 200 OK
POST {{host}}/api/v1/Account/login
Content-Type: {{contentType}}
{
"userName": "AdminUser",
"password": "123Pa$$word!"
}

