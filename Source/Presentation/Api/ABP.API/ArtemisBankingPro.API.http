GET {{host}}/api/v1/Admin/commerce
Authorization: Bearer 1f4XSa{{token}}

### ========================================
### HERMES PAY (Simulacion de Terminal de Pagos)
### ========================================

### COMMERCE - Crear comercio para Hermes Pay
# Esperado: 201 Created
POST {{host}}/api/v1/Admin/commerce
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Tienda Demo Hermes",
  "description": "Comercio de prueba para pagos Hermes Pay",
  "rnc": "101999999",
  "email": "contacto@tiendademohermes.com",
  "phoneNumber": "8095551234",
  "logo": "logo-hermes.png"
}


### COMMERCE - Crear un usuario asociado al comercio (REQUERIDO PARA COBRAR)
# Esperado: 201 Created
POST {{host}}/api/v1/Admin/users/commerce/{{commerceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "firstName": "Admin",
  "lastName": "Tienda Demo",
  "cedula": "00100000002",
  "email": "contacto@tiendademohermes.com",
  "userName": "tiendademohermes",
  "password": "123Paword!",
  "confirmPassword": "123Paword!"
}

### HERMES PAY - Procesar un pago
# Esperado: 204 No Content
POST {{host}}/api/v1/pay/process-payment/{{commerceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}
Idempotency-Key: {{$guid}}

{
  "cardNumber": "4111222233334444",
  "monthExpirationCard": "12",
  "yearExpirationCard": "2028",
  "cvc": "123",
  "transactionAmount": 500.00
}

### HERMES PAY - Obtener transacciones del comercio
# Esperado: 200 OK
GET {{host}}/api/v1/pay/get-transactions/{{commerceId}}
Authorization: Bearer {{token}}

### HERMES PAY - Pago con tarjeta declinada (fondos insuficientes)
# Esperado: 400 Bad Request
POST {{host}}/api/v1/pay/process-payment/{{commerceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}
Idempotency-Key: {{$guid}}

{
  "cardNumber": "4111222233334444",
  "monthExpirationCard": "12",
  "yearExpirationCard": "2028",
  "cvc": "123",
  "transactionAmount": 999999999.00
}

