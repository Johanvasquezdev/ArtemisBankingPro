### ========================================
### HERMES PAY (Simulacion de Terminal de Pagos)
### ========================================

# ¡ATENCION! CAMBIA ESTE NUMERO AL ID QUE TE DEVUELVA EL COMERCIO NUEVO
@hermesCommerceId = 15

### 1) COMMERCE - Crear comercio nuevo (Prueba limpia)
# Esperado: 201 Created
# --> FÍJATE EN EL ID QUE TE DEVUELVE Y PONLO EN @hermesCommerceId ARRIBA
POST {{host}}/api/v1/Admin/commerce
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Super Tienda Hermes 100",
  "description": "Comercio de prueba para pagos Hermes Pay",
  "rnc": "123123123",
  "email": "contacto100@supertiendahermes.com",
  "phoneNumber": "8095551254",
  "logo": "logo-hermes.png"
}

### 2) COMMERCE - Crear un usuario (REQUERIDO PARA COBRAR)
# Esperado: 201 Created
POST {{host}}/api/v1/Admin/users/commerce/{{hermesCommerceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "firstName": "Super",
  "lastName": "Admin Hermes",
  "cedula": "00111111111",
  "email": "admin100@supertiendahermes.com",
  "userName": "superadminhermes100",
  "password": "1234Password!",
  "confirmPassword": "1234Password!"
}

### 3) HERMES PAY - Procesar un pago
# Esperado: 204 No Content
POST {{host}}/api/v1/pay/process-payment/{{hermesCommerceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}
Idempotency-Key: {{$guid}}

{
  "cardNumber": "6387296958553979",
  "monthExpirationCard": "08",
  "yearExpirationCard": "2031",
  "cvc": "910",
  "transactionAmount": 500.00
}

### 4) HERMES PAY - Obtener transacciones del comercio
# Esperado: 200 OK
GET {{host}}/api/v1/pay/get-transactions/{{hermesCommerceId}}
Authorization: Bearer {{token}}

