<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\ABP.Core.Application\ABP.Core.Application.csproj" />
    <ProjectReference Include="..\..\..\Core\ABP.Core.Domain\ABP.Core.Domain.csproj" />
    <ProjectReference Include="..\..\..\Infraestructure\ABP.Infraestructure.Persistence\ABP.Infraestructure.Persistence.csproj" />
    <ProjectReference Include="..\..\..\Infraestructure\ABP.Infraestructure.identity\ABP.Infraestructure.identity.csproj" />
    <ProjectReference Include="..\..\..\Infraestructure\ABP.Infraestructure.Shared\ABP.Infraestructure.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.2" />
