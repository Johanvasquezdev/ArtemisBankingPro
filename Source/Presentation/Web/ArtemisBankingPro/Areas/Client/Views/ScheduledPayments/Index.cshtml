@using ABP.Core.Application.DTOs.ScheduledPayment
@using System.Globalization
@model List<ScheduledPaymentDto>

@{
    ViewData["Title"] = "Pagos Programados";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var culture = CultureInfo.GetCultureInfo("es-DO");
}

<div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <svg class="text-gold" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <h2 class="text-2xl font-serif font-medium text-obsidian tracking-tight">Pagos Programados</h2>
            </div>
            <p class="text-sm text-obsidian/60">Automatiza el pago de tus servicios recurrentes (Luz, Agua, Internet, Suscripciones).</p>
        </div>
        <button type="button" onclick="document.getElementById('createPaymentModal').classList.remove('hidden')" class="bg-obsidian text-ivory hover:bg-gold px-5 py-2.5 rounded-lg font-medium transition-colors shadow-md flex items-center gap-2 text-sm shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Nuevo Pago
        </button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="p-12 bg-panel abp-glass-card abp-glow-border border border-obsidian/10 rounded-xl text-center">
            <div class="w-16 h-16 rounded-full bg-obsidian/5 flex items-center justify-center mx-auto mb-4 text-gold">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
            <h3 class="font-serif text-xl font-medium text-obsidian mb-2">Sin pagos automatizados</h3>
            <p class="text-obsidian/60 text-sm max-w-sm mx-auto mb-6">Despreocúpate de las fechas de vencimiento. Programa tus facturas para que se paguen solas.</p>
            <button type="button" onclick="document.getElementById('createPaymentModal').classList.remove('hidden')" class="text-gold font-semibold hover:text-gold-light transition-colors">Programar primer pago &rarr;</button>
        </div>
    }
    else
    {
        <div class="bg-panel abp-glass-card abp-glow-border border border-obsidian/10 rounded-2xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-obsidian/5 border-b border-obsidian/10">
                            <th class="py-4 px-6 font-semibold text-xs text-obsidian uppercase tracking-wider">Servicio</th>
                            <th class="py-4 px-6 font-semibold text-xs text-obsidian uppercase tracking-wider">Contrato</th>
                            <th class="py-4 px-6 font-semibold text-xs text-obsidian uppercase tracking-wider">Monto (RD$)</th>
                            <th class="py-4 px-6 font-semibold text-xs text-obsidian uppercase tracking-wider">Día de Cobro</th>
                            <th class="py-4 px-6 font-semibold text-xs text-obsidian uppercase tracking-wider">Estado</th>
                            <th class="py-4 px-6 font-semibold text-xs text-obsidian uppercase tracking-wider text-right">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-obsidian/10">
                        @foreach(var payment in Model)
                        {
                            <tr class="hover:bg-obsidian/[0.02] transition-colors">
                                <td class="py-4 px-6 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gold/10 flex items-center justify-center text-gold shrink-0">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                        </div>
                                        <span class="font-medium text-sm text-obsidian">@payment.ServiceName</span>
                                    </div>
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap text-sm text-obsidian/70 font-mono">
                                    @payment.ContractNumber
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap text-sm font-semibold text-obsidian">
                                    @payment.Amount.ToString("N2", culture)
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap">
                                    <div class="flex items-center gap-1.5 text-sm text-obsidian/70">
                                        <svg class="w-4 h-4 text-obsidian/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        Día @payment.ExecutionDay
                                    </div>
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap">
                                    @if (payment.IsActive) {
                                        <span class="inline-flex items-center gap-1.5 bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                            Activo
                                        </span>
                                    } else {
                                        <span class="inline-flex items-center gap-1.5 bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Pausado
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap text-right">
                                    <form asp-action="Toggle" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@payment.Id" />
                                        <button type="submit" class="text-xs font-semibold px-3 py-1.5 rounded-md border transition-colors @(payment.IsActive ? "border-obsidian/20 text-obsidian/60 hover:bg-obsidian/5 hover:text-obsidian" : "border-gold text-gold hover:bg-gold hover:text-white")">
                                            @(payment.IsActive ? "Pausar" : "Reanudar")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal -->
<div id="createPaymentModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-obsidian/60 backdrop-blur-sm p-4">
    <div class="bg-panel border border-obsidian/10 rounded-2xl p-8 max-w-md w-full relative shadow-2xl animate-fade-in-up">
        <button onclick="this.closest('#createPaymentModal').classList.add('hidden')" class="absolute top-4 right-4 text-obsidian/40 hover:text-obsidian transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full bg-gold/10 flex items-center justify-center text-gold">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3 class="font-serif text-2xl font-bold text-obsidian">Programar Pago</h3>
        </div>
        <form asp-action="Create" method="post" class="space-y-5">
            <input type="hidden" name="SavingsAccountId" value="@ViewBag.MainAccountId" />
            
            <div>
                <label class="block text-sm font-medium text-obsidian mb-1">Servicio (Ej. Luz, Agua, Netflix)</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-obsidian/40">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    </div>
                    <input type="text" name="ServiceName" class="w-full bg-white border border-obsidian/20 rounded-lg pl-10 pr-4 py-2.5 text-obsidian focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="Nombre del servicio" required />
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-obsidian mb-1">Número de Contrato</label>
                <input type="text" name="ContractNumber" class="w-full bg-white border border-obsidian/20 rounded-lg px-4 py-2.5 text-obsidian font-mono focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="Ej: 10023458" required />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-obsidian mb-1">Monto (RD$)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-obsidian/40">
                            <span class="font-mono text-sm">$</span>
                        </div>
                        <input type="number" name="Amount" step="0.01" min="1" class="w-full bg-white border border-obsidian/20 rounded-lg pl-8 pr-4 py-2.5 text-obsidian focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="0.00" required />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-obsidian mb-1">Día de Cobro (1-28)</label>
                    <input type="number" name="ExecutionDay" min="1" max="28" class="w-full bg-white border border-obsidian/20 rounded-lg px-4 py-2.5 text-obsidian focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="Día del mes" required />
                </div>
            </div>
            
            <button type="submit" class="w-full bg-obsidian text-ivory hover:bg-gold py-3.5 rounded-lg font-semibold transition-colors shadow-md flex justify-center items-center gap-2 mt-2">
                Programar Servicio
            </button>
        </form>
    </div>
</div>
