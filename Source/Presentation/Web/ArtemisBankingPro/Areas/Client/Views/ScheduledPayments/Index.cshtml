@using System.Globalization
@model IEnumerable<ABP.Core.Application.DTOs.ScheduledPayment.ScheduledPaymentDto>
@{
    ViewData["Title"] = "Pagos Programados";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var culture = new CultureInfo("es-DO");
}

<div class="mb-10 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center animate-fade-in-up">
    <div>
        <h1 class="font-serif text-3xl font-bold text-obsidian mb-2">Pagos Programados</h1>
        <p class="text-obsidian/60 max-w-2xl text-sm leading-relaxed">No vuelvas a pagar recargos. Programa tus servicios recurrentes y Artemis se encargar de pagarlos puntualmente el da que elijas.</p>
    </div>
    <button onclick="document.getElementById('createPaymentModal').classList.remove('hidden')" class="shrink-0 rounded-full bg-obsidian px-6 py-3 text-sm font-semibold text-white shadow-xl shadow-obsidian/20 transition-all hover:-translate-y-1 hover:bg-gold hover:shadow-gold/20 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Programar Servicio
    </button>
</div>

<div class="relative z-10">
    @if (!Model.Any())
    {
        <div class="py-20 flex flex-col items-center justify-center text-center bg-panel border border-obsidian/10 rounded-3xl shadow-sm">
            <div class="w-24 h-24 bg-gold/10 rounded-full flex items-center justify-center text-gold mb-6">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h2 class="text-xl font-bold font-serif text-obsidian mb-2">Sin pagos programados</h2>
            <p class="text-obsidian/60 max-w-sm mb-6">Automatiza el pago de tus servicios, suscripciones y facturas recurrentes.</p>
            <button onclick="document.getElementById('createPaymentModal').classList.remove('hidden')" class="text-gold font-bold hover:text-obsidian transition-colors underline underline-offset-4">Empezar a programar</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var payment in Model)
            {
                <div class="group relative bg-panel rounded-3xl p-6 border border-obsidian/10 hover:border-gold/30 hover:shadow-2xl transition-all duration-300">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-obsidian/5 to-obsidian/10 flex items-center justify-center text-obsidian border border-obsidian/10 group-hover:scale-110 transition-transform duration-500">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        </div>
                        <div class="flex flex-col items-end">
                            <span class="text-2xl font-mono font-bold text-obsidian">@payment.Amount.ToString("C2", culture)</span>
                            <span class="text-xs text-obsidian/50 font-medium uppercase tracking-wider mt-1">Deduccin mensual</span>
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <h3 class="font-serif text-xl font-bold text-obsidian mb-1">@payment.ServiceName</h3>
                        <p class="font-mono text-sm text-obsidian/60 tracking-wider">REF: @payment.ContractNumber</p>
                    </div>

                    <div class="flex items-center gap-3 mb-6 bg-obsidian/5 rounded-xl p-3 border border-obsidian/5">
                        <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-obsidian shadow-sm shrink-0">
                            <span class="font-bold text-sm">@payment.ExecutionDay</span>
                        </div>
                        <div>
                            <span class="block text-xs uppercase tracking-wider font-bold text-obsidian/50">Día de pago</span>
                            <span class="block text-sm text-obsidian font-medium">De cada mes</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-obsidian/10">
                        @if (payment.IsActive) {
                            <span class="inline-flex items-center gap-2 bg-green-500/10 text-green-600 dark:text-green-400 text-[10px] font-bold px-3 py-1.5 rounded-lg uppercase tracking-widest border border-green-500/20">
                                <span class="relative flex h-2 w-2">
                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                  <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                                </span>
                                Activo
                            </span>
                        } else {
                            <span class="inline-flex items-center gap-2 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[10px] font-bold px-3 py-1.5 rounded-lg uppercase tracking-widest border border-amber-500/20">
                                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                Pausado
                            </span>
                        }
                        
                        <form asp-action="Toggle" method="post" class="m-0">
                            <input type="hidden" name="id" value="@payment.Id" />
                            <button type="submit" class="text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-sm @(payment.IsActive ? "bg-obsidian/5 text-obsidian/70 hover:bg-obsidian hover:text-white" : "bg-gold text-obsidian hover:bg-yellow-500 shadow-gold/20")">
                                @(payment.IsActive ? "Pausar" : "Reanudar")
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal -->
<div id="createPaymentModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-obsidian/80 backdrop-blur-md p-4">
    <div class="bg-panel border border-white/10 rounded-3xl p-8 max-w-md w-full relative shadow-2xl animate-fade-in-up">
        <button onclick="this.closest('#createPaymentModal').classList.add('hidden')" class="absolute top-6 right-6 text-obsidian/40 hover:text-obsidian transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-gold/10 flex items-center justify-center text-gold shadow-inner">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3 class="font-serif text-2xl font-bold text-obsidian">Programar Pago</h3>
        </div>
        <form asp-action="Create" method="post" class="space-y-6">
            <input type="hidden" name="SavingsAccountId" value="@ViewBag.MainAccountId" />
            
            <div>
                <label class="block text-xs font-bold text-obsidian/70 uppercase tracking-wider mb-2">Servicio o Entidad</label>
                <div class="relative">
                    <input type="text" name="ServiceName" class="w-full bg-transparent border-b-2 border-obsidian/20 pl-0 pr-4 py-3 text-lg text-obsidian focus:border-gold outline-none transition-colors placeholder-obsidian/20" placeholder="Ej: Luz, Agua, Netflix" required />
                </div>
            </div>
            
            <div>
                <label class="block text-xs font-bold text-obsidian/70 uppercase tracking-wider mb-2">Nmero de Contrato / Referencia</label>
                <input type="text" name="ContractNumber" class="w-full bg-transparent border-b-2 border-obsidian/20 px-0 py-3 text-lg text-obsidian font-mono focus:border-gold outline-none transition-colors placeholder-obsidian/20" placeholder="Ej: 10023458" required />
            </div>
            
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-bold text-obsidian/70 uppercase tracking-wider mb-2">Monto Fijo (RD$)</label>
                    <input type="number" name="Amount" step="0.01" min="1" class="w-full bg-transparent border-b-2 border-obsidian/20 px-0 py-3 text-lg text-obsidian font-mono focus:border-gold outline-none transition-colors placeholder-obsidian/20" placeholder="0.00" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-obsidian/70 uppercase tracking-wider mb-2">Da del Mes (1-28)</label>
                    <input type="number" name="ExecutionDay" min="1" max="28" class="w-full bg-transparent border-b-2 border-obsidian/20 px-0 py-3 text-lg text-obsidian font-mono focus:border-gold outline-none transition-colors placeholder-obsidian/20" placeholder="Ej: 15" required />
                </div>
            </div>
            
            <button type="submit" class="w-full bg-obsidian text-ivory hover:bg-gold py-4 rounded-xl font-bold transition-colors shadow-xl shadow-obsidian/10 mt-8 text-lg">
                Activar Pago Programado
            </button>
        </form>
    </div>
</div>

