@using System.Globalization
@model IEnumerable<ABP.Core.Application.DTOs.VirtualCard.VirtualCardDto>
@{
    ViewData["Title"] = "Tarjetas Virtuales";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var culture = new CultureInfo("es-DO");
    var accounts = ViewBag.Accounts as IEnumerable<ABP.Core.Application.DTOs.SavingsAccount.SavingsAccountDto>;
}

<div class="mb-10 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center animate-fade-in-up">
    <div>
        <h1 class="font-serif text-3xl font-bold text-obsidian mb-2">Tarjetas Virtuales</h1>
        <p class="text-obsidian/60 max-w-2xl text-sm leading-relaxed">Genera tarjetas desechables para proteger tus datos en compras online. Control total sobre tus suscripciones con congelamiento instantneo.</p>
    </div>
    <button onclick="document.getElementById('createCardModal').classList.remove('hidden')" class="shrink-0 rounded-full bg-obsidian px-6 py-3 text-sm font-semibold text-white shadow-xl shadow-obsidian/20 transition-all hover:-translate-y-1 hover:bg-gold hover:shadow-gold/20 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Generar Tarjeta
    </button>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8 relative z-10">
    @if (!Model.Any())
    {
        <div class="col-span-full py-16 flex flex-col items-center justify-center text-center bg-panel border border-obsidian/10 rounded-3xl shadow-sm">
            <div class="w-24 h-24 bg-gold/10 rounded-full flex items-center justify-center text-gold mb-6">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
            </div>
            <h2 class="text-xl font-bold font-serif text-obsidian mb-2">No tienes tarjetas virtuales activas</h2>
            <p class="text-obsidian/60 max-w-sm mb-6">Protege tus compras online generando una tarjeta digital al instante.</p>
            <button onclick="document.getElementById('createCardModal').classList.remove('hidden')" class="text-gold font-bold hover:text-obsidian transition-colors underline underline-offset-4">Generar ahora</button>
        </div>
    }
    else
    {
        <div class="col-span-full grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
            @foreach (var card in Model)
            {
                <article class="group relative w-full aspect-[1.586] rounded-3xl overflow-hidden shadow-2xl transition-all duration-500 hover:-translate-y-2 hover:shadow-gold/20">
                    <!-- Premium Glassmorphism Background -->
                    <div class="absolute inset-0 bg-gradient-to-br from-[#111] via-obsidian to-[#222]"></div>
                    <!-- Mesh Gradient / Noise -->
                    <div class="absolute inset-0 bg-[url('/images/noise.png')] opacity-20 mix-blend-overlay pointer-events-none"></div>
                    <!-- Holographic Glow -->
                    <div class="absolute -top-32 -right-32 w-64 h-64 bg-gold/20 rounded-full blur-[80px] pointer-events-none group-hover:bg-gold/40 transition-colors duration-700"></div>
                    <div class="absolute -bottom-32 -left-32 w-64 h-64 bg-blue-500/20 rounded-full blur-[80px] pointer-events-none group-hover:bg-blue-400/40 transition-colors duration-700"></div>

                    @if (card.IsFrozen)
                    {
                        <!-- Frost Effect if frozen -->
                        <div class="absolute inset-0 bg-white/10 backdrop-blur-[2px] z-20 transition-all duration-300"></div>
                    }

                    <div class="relative z-30 h-full p-8 flex flex-col justify-between">
                        <!-- Top: Logo & Network -->
                        <div class="flex justify-between items-start">
                            <span class="font-serif font-bold text-white text-xl tracking-widest drop-shadow-md">ARTEMIS</span>
                            <svg class="w-12 h-8" viewBox="0 0 36 24" fill="none">
                                <circle cx="12" cy="12" r="12" fill="#EA001B" fill-opacity="0.8"/>
                                <circle cx="24" cy="12" r="12" fill="#F79E1B" fill-opacity="0.8"/>
                                <path d="M18 20.47a11.97 11.97 0 004.24-8.47A11.97 11.97 0 0018 3.53a11.97 11.97 0 00-4.24 8.47A11.97 11.97 0 0018 20.47z" fill="#FF5F00"/>
                            </svg>
                        </div>

                        <!-- Middle: Chip & Contactless -->
                        <div class="flex flex-col gap-6">
                            <div class="w-12 h-10 rounded bg-gradient-to-br from-[#F5D76E] to-[#CBA358] opacity-90 shadow-sm overflow-hidden relative">
                                <div class="absolute inset-0 border border-black/20 rounded"></div>
                                <div class="absolute inset-y-0 left-1/2 w-px bg-black/10"></div>
                                <div class="absolute inset-x-0 top-1/2 h-px bg-black/10"></div>
                            </div>
                            
                            <!-- Card Number -->
                            <div class="font-mono text-white text-2xl tracking-[0.15em] drop-shadow-md">
                                @string.Join(" ", Enumerable.Range(0, 4).Select(i => card.CardNumber.Substring(i * 4, 4)))
                            </div>
                        </div>

                        <!-- Bottom: Details -->
                        <div class="flex justify-between items-end">
                            <div>
                                <span class="block text-[8px] text-white/50 uppercase tracking-widest mb-1">Titular</span>
                                <span class="font-bold text-white tracking-widest uppercase drop-shadow-md text-sm">CLIENTE PRIVADO</span>
                            </div>
                            <div class="flex gap-6">
                                <div>
                                    <span class="block text-[8px] text-white/50 uppercase tracking-widest mb-1">Vence</span>
                                    <span class="font-mono text-white text-sm">@card.ExpirationDate.ToString("MM/yy")</span>
                                </div>
                                <div class="relative group/cvv">
                                    <span class="block text-[8px] text-white/50 uppercase tracking-widest mb-1">CVV</span>
                                    <button type="button" class="font-mono text-gold bg-white/10 px-2 py-0.5 rounded text-sm hover:bg-gold hover:text-obsidian transition-colors focus:outline-none" onclick="verifyBiometricForCvv(@card.Id, this)">
                                        VER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Overlay Actions (Hover) -->
                    <div class="absolute inset-0 bg-obsidian/80 backdrop-blur-sm z-40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-6">
                        <div class="flex flex-col gap-3 w-full max-w-[200px] translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                            <form asp-action="ToggleFreeze" asp-route-id="@card.Id" method="post" class="w-full">
                                <button type="submit" class="w-full bg-white text-obsidian text-sm font-bold px-4 py-3 rounded-xl hover:bg-gold transition-colors flex items-center justify-center gap-2 shadow-lg">
                                    @if(card.IsFrozen) {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path></svg>
                                        <span>Descongelar</span>
                                    } else {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8V7a4 4 0 00-8 0v4h8z"></path></svg>
                                        <span>Congelar Tarjeta</span>
                                    }
                                </button>
                            </form>
                            @if(card.IsFrozen) {
                                <div class="text-center">
                                    <span class="inline-flex items-center justify-center gap-1.5 text-xs text-white uppercase tracking-widest font-bold">
                                        <svg class="w-3 h-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8V7a4 4 0 00-8 0v4h8z"></path></svg>
                                        Congelada
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<!-- Create Modal -->
<div id="createCardModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-obsidian/80 backdrop-blur-md p-4">
    <div class="bg-panel border border-white/10 rounded-3xl p-8 max-w-md w-full relative shadow-2xl animate-fade-in-up">
        <button onclick="this.closest('#createCardModal').classList.add('hidden')" class="absolute top-6 right-6 text-obsidian/40 hover:text-obsidian transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-gold/10 flex items-center justify-center text-gold shadow-inner">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <h3 class="font-serif text-2xl font-bold text-obsidian">Nueva Tarjeta</h3>
        </div>
        <form asp-action="Create" method="post" class="space-y-6">
            <div>
                <label class="block text-xs font-bold text-obsidian/70 uppercase tracking-wider mb-2">Cuenta de Origen</label>
                <div class="relative">
                    <select name="savingsAccountId" class="w-full bg-transparent border-b-2 border-obsidian/20 px-0 py-3 text-lg text-obsidian focus:border-gold outline-none appearance-none transition-colors cursor-pointer" required>
                        <option value="">-- Seleccione una cuenta --</option>
                        @if(accounts != null) {
                            foreach(var acc in accounts) {
                                <option value="@acc.Id">@acc.AccountNumber - @acc.Balance.ToString("C2", culture)</option>
                            }
                        }
                    </select>
                    <div class="absolute inset-y-0 right-0 flex items-center pointer-events-none text-obsidian/50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>
                <p class="text-xs text-obsidian/50 mt-3 leading-relaxed">Los fondos se deducirn directamente de esta cuenta al procesar compras. La tarjeta es desechable y puede eliminarse o congelarse en cualquier momento.</p>
            </div>
            <button type="submit" class="w-full bg-obsidian text-ivory hover:bg-gold py-4 rounded-xl font-bold transition-colors shadow-xl shadow-obsidian/10 mt-8 text-lg flex justify-center items-center gap-2">
                Generar y Activar Tarjeta
            </button>
        </form>
    </div>
</div>

<script>
    async function verifyBiometricForCvv(cardId, buttonElement) {
        try {
            // Animacion de carga simple
            const originalText = buttonElement.innerText;
            buttonElement.innerText = "...";
            buttonElement.disabled = true;

            const publicKeyCredentialRequestOptions = {
                challenge: new Uint8Array(32),
                timeout: 60000,
                userVerification: "required"
            };

            let assertion = null;
            try {
                if (navigator.credentials && navigator.credentials.get) {
                    assertion = await navigator.credentials.get({
                        publicKey: publicKeyCredentialRequestOptions
                    });
                } else {
                    throw new Error("WebAuthn not supported");
                }
            } catch (e) {
                console.log("WebAuthn fallback: ", e);
                if(!confirm("No se detect biometra. Deseas usar tu PIN de seguridad (Modo Demo)?")) {
                    buttonElement.innerText = originalText;
                    buttonElement.disabled = false;
                    return;
                }
                assertion = { id: "fallback_demo_assertion" };
            }

            if (assertion) {
                const response = await fetch('/Client/VirtualCards/GetCvv?id=' + cardId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ assertion: assertion.id })
                });

                if (response.ok) {
                    const data = await response.json();
                    buttonElement.innerText = data.cvv;
                    buttonElement.classList.remove('bg-white/10', 'text-gold');
                    buttonElement.classList.add('bg-white', 'text-obsidian');
                    
                    setTimeout(() => {
                        buttonElement.innerText = originalText;
                        buttonElement.classList.remove('bg-white', 'text-obsidian');
                        buttonElement.classList.add('bg-white/10', 'text-gold');
                        buttonElement.disabled = false;
                    }, 5000);
                } else {
                    alert("Error al verificar identidad.");
                    buttonElement.innerText = originalText;
                    buttonElement.disabled = false;
                }
            }
        } catch (err) {
            console.error(err);
            alert("Error procesando biometra.");
            buttonElement.innerText = "VER";
            buttonElement.disabled = false;
        }
    }
</script>

