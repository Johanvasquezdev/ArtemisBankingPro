@model ABP.Core.Application.ViewModels.Client.ClientHomeViewModel
@{
    ViewData["Title"] = "Inicio";
    var culture = CultureInfo.GetCultureInfo("es-DO");
    string MaskCard(string cardNumber)
        => cardNumber.Length >= 4 ? $"•••• •••• •••• {cardNumber[^4..]}" : cardNumber;
}

<!-- Welcome Section -->
<div class="flex flex-col md:flex-row md:justify-between md:items-end mb-10 gap-4">
    <div>
        <h1 class="font-serif text-4xl text-obsidian font-medium mb-1">Hola, @Model.ClientFullName</h1>
        <p class="text-obsidian/60 text-sm">Resumen de su portafolio privado</p>
    </div>
</div>

@if (Model.HasDelinquentLoans)
{
    <div class="mb-10 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg flex items-start gap-3 shadow-sm">
        <svg class="mt-0.5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span class="text-sm font-medium">Tiene préstamo(s) en mora. Le recomendamos realizar el pago de sus cuotas pendientes lo antes posible para mantener su estatus de élite.</span>
    </div>
}

<!-- Quick Actions -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
    <a asp-controller="Transactions" asp-action="Express" class="group relative flex min-h-32 items-center justify-between overflow-hidden rounded-2xl border border-gold/20 bg-panel p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/50 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/50 focus-visible:ring-offset-2 no-underline">
        <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gold/20 bg-gold/10 text-gold transition-all duration-300 group-hover:bg-gold group-hover:text-white">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3v18"/><path d="M3 17l4 4 4-4"/><path d="M7 21V3"/><path d="M21 7l-4-4-4 4"/></svg>
            </div>
            <div>
                <h4 class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold-dark">Transferir</h4>
                <h3 class="mt-1 font-serif text-xl font-medium tracking-tight text-obsidian">Express</h3>
            </div>
        </div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-obsidian/10 text-obsidian/40 transition-all duration-300 group-hover:border-gold/40 group-hover:bg-gold/10 group-hover:text-gold" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </span>
    </a>
    <a asp-controller="Transactions" asp-action="PayCreditCard" class="group relative flex min-h-32 items-center justify-between overflow-hidden rounded-2xl border border-gold/20 bg-panel p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/50 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/50 focus-visible:ring-offset-2 no-underline">
        <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gold/20 bg-gold/10 text-gold transition-all duration-300 group-hover:bg-gold group-hover:text-white">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <div>
                <h4 class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold-dark">Pagar</h4>
                <h3 class="mt-1 font-serif text-xl font-medium tracking-tight text-obsidian">Tarjeta</h3>
            </div>
        </div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-obsidian/10 text-obsidian/40 transition-all duration-300 group-hover:border-gold/40 group-hover:bg-gold/10 group-hover:text-gold" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </span>
    </a>
    <a asp-controller="CashAdvance" asp-action="Index" class="group relative flex min-h-32 items-center justify-between overflow-hidden rounded-2xl border border-gold/20 bg-panel p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/50 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/50 focus-visible:ring-offset-2 no-underline">
        <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gold/20 bg-gold/10 text-gold transition-all duration-300 group-hover:bg-gold group-hover:text-white">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
                <h4 class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold-dark">Retirar</h4>
                <h3 class="mt-1 font-serif text-xl font-medium tracking-tight text-obsidian">Avance</h3>
            </div>
        </div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-obsidian/10 text-obsidian/40 transition-all duration-300 group-hover:border-gold/40 group-hover:bg-gold/10 group-hover:text-gold" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </span>
    </a>
</div>

<!-- Primary Row: Accounts & Transactions -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    <!-- Accounts -->
    <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-6">
            <svg class="text-gold" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            <h2 class="font-serif text-2xl font-medium text-obsidian">Liquidez</h2>
        </div>
        
        @if (Model.Accounts.Count == 0)
        {
            <div class="p-8 bg-panel border border-obsidian/10 rounded-xl text-center text-obsidian/60">
                No posee cuentas de ahorro.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var account in Model.Accounts)
                {
                    <div class="bg-panel border border-obsidian/10 rounded-xl p-6 flex flex-col justify-between hover:shadow-lg hover:border-gold/30 transition-all">
                        <div>
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-[0.65rem] uppercase tracking-widest text-obsidian/60">Cuenta de Ahorro</span>
                                @if (account.Status == AccountStatus.Active) {
                                    <span class="px-2 py-1 text-[0.65rem] uppercase tracking-wider bg-green-50 text-green-700 rounded-full border border-green-200">Activa</span>
                                } else {
                                    <span class="px-2 py-1 text-[0.65rem] uppercase tracking-wider bg-gray-50 text-gray-600 rounded-full border border-gray-200">Inactiva</span>
                                }
                            </div>
                            <div class="font-mono text-sm text-obsidian/70 mb-6 tracking-wider">@account.AccountNumber</div>
                            <div class="font-serif text-3xl text-obsidian mb-6">@account.Balance.ToString("C2", culture)</div>
                        </div>
                        <a asp-controller="Home" asp-action="AccountDetail" asp-route-accountNumber="@account.AccountNumber" class="block w-full text-center py-2.5 px-4 text-sm font-medium border border-obsidian/20 text-obsidian rounded-lg hover:bg-obsidian/5 transition-colors">
                            Ver detalles
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Recent Transactions -->
    <div class="lg:col-span-1">
        <div class="flex items-center gap-2 mb-6">
            <svg class="text-gold" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h2 class="font-serif text-2xl font-medium text-obsidian">Recientes</h2>
        </div>
        
        <div class="bg-panel border border-obsidian/10 rounded-xl p-1 overflow-hidden">
            @if (Model.RecentTransactions.Count == 0)
            {
                <div class="p-8 text-center text-sm text-obsidian/60">Aún no tiene transacciones.</div>
            }
            else
            {
                <div class="divide-y divide-obsidian/5">
                    @foreach (var txn in Model.RecentTransactions)
                    {
                        var isDebit = txn.Type == TransactionType.Debit;
                        <div class="p-4 flex justify-between items-center gap-4 hover:bg-obsidian/[0.02] transition-colors">
                            <div class="min-w-0">
                                <div class="font-semibold text-base leading-snug text-obsidian mb-1 break-words">@TransactionDisplayText.LocalizeDescription(txn.Description)</div>
                                <div class="text-sm text-obsidian/70 leading-snug">@txn.TransactionDate.ToString("dd/MM/yyyy") · @txn.Beneficiary</div>
                            </div>
                            <div class="shrink-0 text-right">
                                <div class="font-semibold text-lg leading-tight @(isDebit ? "text-obsidian" : "text-green-600")">
                                    @(isDebit ? "-" : "+")@txn.Amount.ToString("C2", culture)
                                </div>
                                @if (txn.Status == TransactionStatus.Approved) {
                                    <span class="text-xs font-semibold text-green-600 uppercase tracking-wider">Aprobada</span>
                                } else {
                                    <span class="text-xs font-semibold text-red-500 uppercase tracking-wider">Rechazada</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Secondary Row: Credit Cards & Loans -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pt-8 border-t border-obsidian/10">
    
    <!-- Credit Cards -->
    <div>
        <div class="flex items-center gap-2 mb-6">
            <svg class="text-gold opacity-70" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            <h2 class="font-serif text-xl font-medium text-obsidian/80">Tarjetas de Crédito</h2>
        </div>
        
        @if (Model.CreditCards.Count == 0)
        {
            <div class="text-sm text-obsidian/50">No posee tarjetas de crédito.</div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var card in Model.CreditCards)
                {
                    <article class="abp-credit-card" aria-label="Tarjeta de crédito terminada en @(card.CardNumber.Length >= 4 ? card.CardNumber[^4..] : card.CardNumber)">
                        <div class="abp-credit-card-glow" aria-hidden="true"></div>
                        
                        <div class="abp-credit-card-content">
                            <div class="abp-credit-card-header">
                                <img class="abp-credit-card-logo" src="@Url.Content("~/images/artemis-banking-logo-light.svg")" alt="Artemis Banking Pro" />
                                <svg class="abp-credit-card-nfc" viewBox="0 0 32 32" role="img" aria-label="Pago sin contacto">
                                    <title>Pago sin contacto</title>
                                    <path d="M7.5 12.5a7 7 0 0 0 0 7" />
                                    <path d="M12 9a11.5 11.5 0 0 0 0 14" />
                                    <path d="M16.5 5.5a16.5 16.5 0 0 0 0 21" />
                                    <path d="M22 12.5a7 7 0 0 1 0 7" />
                                </svg>
                            </div>

                            <div class="abp-credit-card-number">@MaskCard(card.CardNumber)</div>

                            <div class="abp-credit-card-footer">
                                <div>
                                    <span class="abp-credit-card-label">Disponible</span>
                                    <strong>@card.AvailableBalance.ToString("C2", culture)</strong>
                                </div>
                                <div>
                                    <span class="abp-credit-card-label">Vence</span>
                                    <strong>@card.ExpirationDate</strong>
                                </div>
                                <div class="text-right">
                                    <span class="abp-credit-card-label">Deuda</span>
                                    <strong class="abp-credit-card-debt">@card.AmountOwed.ToString("C2", culture)</strong>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <!-- Loans -->
    <div>
        <div class="flex items-center gap-2 mb-6">
            <svg class="text-gold opacity-70" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <h2 class="font-serif text-2xl font-medium text-obsidian/80">Préstamos</h2>
        </div>
        
        @if (Model.Loans.Count == 0)
        {
            <div class="text-sm text-obsidian/50">No posee préstamos activos.</div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var loan in Model.Loans)
                {
                    <div class="bg-panel border border-obsidian/10 rounded-xl p-6">
                        <div class="flex justify-between items-center mb-3">
                            <span class="font-serif text-lg font-medium text-obsidian">Préstamo @loan.LoanNumber</span>
                            @if (loan.IsOnTime)
                            {
                                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-green-50 text-green-700 rounded-full border border-green-200">Al día</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-red-50 text-red-700 rounded-full border border-red-200">En mora</span>
                            }
                        </div>
                        <div class="flex justify-between gap-3 text-sm mb-3">
                            <span class="text-obsidian/60">Progreso: @loan.PaidInstallments / @loan.TotalInstallments</span>
                            <span class="font-semibold text-base text-obsidian text-right">@loan.PendingAmount.ToString("C2", culture) pendientes</span>
                        </div>
                        @{
                            var progressPercent = loan.TotalInstallments > 0 ? (int)((double)loan.PaidInstallments / loan.TotalInstallments * 100) : 0;
                        }
                        <div class="w-full h-2.5 bg-obsidian/5 rounded-full overflow-hidden mb-5" aria-label="@progressPercent% pagado">
                            <div class="h-full bg-gold rounded-full" style="width: @(progressPercent)%;"></div>
                        </div>
                        <a asp-controller="Transactions" asp-action="PayLoan" class="block w-full text-center py-3 px-4 text-sm font-semibold border border-obsidian/20 text-obsidian rounded-lg hover:bg-obsidian/5 transition-colors">
                            Pagar Cuota
                        </a>
                    </div>
                }
            </div>
        }
    </div>

</div>
