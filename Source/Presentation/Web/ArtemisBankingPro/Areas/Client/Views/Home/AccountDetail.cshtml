@model ABP.Core.Application.ViewModels.Client.AccountDetailViewModel
@{
    ViewData["Title"] = "Detalle de Cuenta";
    var culture = CultureInfo.GetCultureInfo("es-DO");
}

<div class="abp-content-header abp-flex abp-justify-between abp-items-center abp-mb-xl">
    <div>
        <h1 class="abp-heading-xl abp-font-serif">Detalle de Cuenta <span class="abp-font-mono abp-text-gold">@Model.AccountNumber</span></h1>
        <p class="abp-text-muted abp-mt-sm">Titular: @Model.OwnerFullName</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="abp-btn-outline">Volver al Inicio</a>
</div>

<div class="abp-grid-4 abp-mb-xl">
    <div class="abp-kpi-card">
        <div class="abp-kpi-label">Saldo</div>
        <div class="abp-kpi-value abp-text-success">@Model.Balance.ToString("C2", culture)</div>
    </div>
    <div class="abp-kpi-card">
        <div class="abp-kpi-label">Tipo</div>
        <div class="abp-kpi-value">@Model.Type</div>
    </div>
    <div class="abp-kpi-card">
        <div class="abp-kpi-label">Estado</div>
        <div class="abp-kpi-value">
            <span class="@(Model.Status == AccountStatus.Active ? "abp-badge-success" : "abp-badge-neutral")">@Model.Status</span>
        </div>
    </div>
    <div class="abp-kpi-card">
        <div class="abp-kpi-label">Total de transacciones</div>
        <div class="abp-kpi-value">@Model.Transactions.Count</div>
    </div>
</div>

<div class="abp-panel abp-mb-xl">
    <form method="get" asp-action="AccountDetail" class="abp-flex abp-items-center abp-gap-md">
        <input type="hidden" name="accountNumber" value="@Model.AccountNumber" />
        <div>
            <label class="abp-label">Desde</label>
            <input type="date" name="dateFrom" class="abp-input" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label class="abp-label">Hasta</label>
            <input type="date" name="dateTo" class="abp-input" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
        </div>
        <div style="margin-top: 1.5rem;">
            <button type="submit" class="abp-btn-gold">Filtrar</button>
        </div>
    </form>
</div>

<div class="abp-panel">
    <h2 class="abp-heading-md abp-font-serif abp-mb-md">Historial de Transacciones</h2>
    @if (Model.Transactions.Count == 0)
    {
        <p class="abp-text-muted abp-mb-0">No hay transacciones para el período seleccionado.</p>
    }
    else
    {
        <table class="abp-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Descripción</th>
                    <th>Beneficiario</th>
                    <th>Monto</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in Model.Transactions)
                {
                    var isDebit = txn.Type == TransactionType.Debit;
                    <tr>
                        <td>@txn.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@TransactionDisplayText.LocalizeDescription(txn.Description)</td>
                        <td>@txn.Beneficiary</td>
                        <td class="@(isDebit ? "abp-text-danger" : "abp-text-success")" style="font-weight: 600;">@(isDebit ? "-" : "+")@txn.Amount.ToString("C2", culture)</td>
                        <td>
                            <span class="@(txn.Status == TransactionStatus.Approved ? "abp-badge-success" : "abp-badge-danger")">@(txn.Status == TransactionStatus.Approved ? "Aprobada" : "Rechazada")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
