@using ABP.Core.Application.DTOs.User
@using ABP.Core.Application.DTOs.SavingsAccount
@using ABP.Core.Application.DTOs.CreditCard
@using ABP.Core.Application.DTOs.Loan
@using System.Globalization
@model UserDto
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var culture = CultureInfo.GetCultureInfo("es-DO");
    
    var accounts = ViewBag.Accounts as IEnumerable<SavingsAccountDto> ?? new List<SavingsAccountDto>();
    var cards = ViewBag.CreditCards as IEnumerable<CreditCardDto> ?? new List<CreditCardDto>();
    var loans = ViewBag.Loans as IEnumerable<LoanDto> ?? new List<LoanDto>();
    
    decimal totalAssets = accounts.Sum(a => a.Balance);
    decimal totalDebtCards = cards.Sum(c => c.AmountOwed);
    decimal totalDebtLoans = loans.Where(l => l.Status == ABP.Core.Domain.Enums.LoanStatus.Active).Sum(l => l.PendingAmount);
    decimal totalLiabilities = totalDebtCards + totalDebtLoans;
}

<div class="space-y-8 animate-fade-in-up">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <svg class="text-gold" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <h2 class="text-2xl font-serif font-medium text-obsidian tracking-tight">Mi Perfil</h2>
            </div>
            <p class="text-sm text-obsidian/60">Información personal y resumen de tus productos financieros.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Info del Usuario -->
        <div class="lg:col-span-1 space-y-6">
            <div class="abp-glass-card bg-panel p-6 rounded-2xl border border-obsidian/10 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gold/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                <div class="flex flex-col items-center text-center relative z-10">
                    <div class="w-24 h-24 rounded-full bg-gradient-to-br from-obsidian to-obsidian/80 text-gold flex items-center justify-center text-3xl font-serif mb-4 shadow-lg border-2 border-gold/20">
                        @Model.FirstName.Substring(0,1)@Model.LastName.Substring(0,1)
                    </div>
                    <h3 class="text-xl font-serif font-bold text-obsidian">@Model.FirstName @Model.LastName</h3>
                    <p class="text-obsidian/60 text-sm mb-4">@Model.Email</p>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Cliente Activo
                    </span>
                </div>
                
                <hr class="my-6 border-obsidian/5" />
                
                <div class="space-y-4">
                    <div>
                        <span class="block text-xs font-bold text-obsidian/50 uppercase tracking-wider mb-1">Usuario</span>
                        <p class="text-obsidian font-medium">@Model.UserName</p>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-obsidian/50 uppercase tracking-wider mb-1">Cédula</span>
                        <p class="text-obsidian font-medium">@Model.Cedula</p>
                    </div>
                </div>
            </div>
            
            <!-- Resumen Financiero -->
            <div class="abp-glass-card bg-obsidian text-ivory p-6 rounded-2xl border border-white/10 shadow-lg relative overflow-hidden">
                <div class="absolute inset-0 bg-[url('/images/noise.png')] opacity-20 mix-blend-overlay pointer-events-none"></div>
                <h4 class="text-sm font-bold text-gold uppercase tracking-wider mb-6 relative z-10">Patrimonio Neto</h4>
                
                <div class="space-y-4 relative z-10">
                    <div class="flex justify-between items-center">
                        <span class="text-ivory/60 text-sm">Activos (Ahorros)</span>
                        <span class="text-emerald-400 font-mono font-medium">@totalAssets.ToString("C2", culture)</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-ivory/60 text-sm">Pasivos (Deudas)</span>
                        <span class="text-red-400 font-mono font-medium">-@totalLiabilities.ToString("C2", culture)</span>
                    </div>
                    <hr class="border-white/10 my-2" />
                    <div class="flex justify-between items-end">
                        <span class="text-ivory text-sm font-bold">Total</span>
                        <span class="text-2xl font-mono font-bold text-white shadow-sm">@((totalAssets - totalLiabilities).ToString("C2", culture))</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Productos -->
        <div class="lg:col-span-2 space-y-6">
            <h3 class="text-lg font-serif font-bold text-obsidian border-b border-obsidian/10 pb-2">Mis Productos</h3>
            
            <!-- Cuentas -->
            <div class="abp-glass-card bg-panel p-5 rounded-2xl border border-obsidian/10 shadow-sm">
                <div class="flex items-center gap-2 mb-4 text-obsidian">
                    <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    <h4 class="font-bold">Cuentas de Ahorro</h4>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach(var acc in accounts) {
                        <div class="p-4 border border-obsidian/10 rounded-xl bg-white hover:border-gold/50 transition-colors">
                            <p class="text-xs text-obsidian/50 font-mono mb-1">@acc.AccountNumber</p>
                            <p class="text-lg font-bold text-obsidian">@acc.Balance.ToString("C2", culture)</p>
                            <p class="text-xs text-emerald-600 mt-2 font-medium flex items-center gap-1"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> Activa</p>
                        </div>
                    }
                    @if(!accounts.Any()) {
                        <p class="text-sm text-obsidian/50 italic col-span-full">No posees cuentas de ahorro.</p>
                    }
                </div>
            </div>

            <!-- Tarjetas -->
            <div class="abp-glass-card bg-panel p-5 rounded-2xl border border-obsidian/10 shadow-sm">
                <div class="flex items-center gap-2 mb-4 text-obsidian">
                    <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    <h4 class="font-bold">Tarjetas de Crédito</h4>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach(var card in cards) {
                        <div class="p-4 border border-obsidian/10 rounded-xl bg-white hover:border-gold/50 transition-colors flex flex-col justify-between">
                            <div>
                                <p class="text-xs text-obsidian/50 font-mono mb-1">**** @card.CardNumber.Substring(12)</p>
                                <p class="text-sm font-medium text-obsidian mb-2">Deuda: @card.AmountOwed.ToString("C2", culture)</p>
                            </div>
                            <div class="w-full bg-obsidian/10 rounded-full h-1.5 overflow-hidden">
                                <div class="bg-gradient-to-r from-red-400 to-red-600 h-1.5 rounded-full" style="width: @(card.CreditLimit > 0 ? (card.AmountOwed / card.CreditLimit * 100).ToString("0", CultureInfo.InvariantCulture) : "0")%"></div>
                            </div>
                        </div>
                    }
                    @if(!cards.Any()) {
                        <p class="text-sm text-obsidian/50 italic col-span-full">No posees tarjetas de crédito.</p>
                    }
                </div>
            </div>

            <!-- Prestamos -->
            <div class="abp-glass-card bg-panel p-5 rounded-2xl border border-obsidian/10 shadow-sm">
                <div class="flex items-center gap-2 mb-4 text-obsidian">
                    <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <h4 class="font-bold">Préstamos</h4>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach(var loan in loans) {
                        var statusColor = loan.Status == ABP.Core.Domain.Enums.LoanStatus.Active ? "text-emerald-600" : loan.Status == ABP.Core.Domain.Enums.LoanStatus.Completed ? "text-blue-600" : "text-red-600";
                        var statusText = loan.Status == ABP.Core.Domain.Enums.LoanStatus.Active ? "Activo" : loan.Status == ABP.Core.Domain.Enums.LoanStatus.Completed ? "Pagado" : "Atrasado";
                        <div class="p-4 border border-obsidian/10 rounded-xl bg-white hover:border-gold/50 transition-colors">
                            <div class="flex justify-between items-start mb-2">
                                <p class="text-lg font-bold text-obsidian">@loan.Amount.ToString("C2", culture)</p>
                                <span class="text-xs font-bold @statusColor bg-@statusColor.Replace("text-", "").Replace("600", "50") px-2 py-0.5 rounded-full">@statusText</span>
                            </div>
                            <p class="text-xs text-obsidian/50">Pagado: @(((loan.Amount - loan.PendingAmount)).ToString("C2", culture))</p>
                        </div>
                    }
                    @if(!loans.Any()) {
                        <p class="text-sm text-obsidian/50 italic col-span-full">No posees préstamos.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
