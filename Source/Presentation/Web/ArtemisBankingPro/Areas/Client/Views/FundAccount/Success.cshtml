@{
    ViewData["Title"] = "Top-Up Successful";
}

<div class="flex items-center justify-center min-h-[70vh]">
    <div class="abp-glass-card w-full max-w-md p-10 rounded-2xl shadow-xl text-center relative overflow-hidden">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full bg-green-500 opacity-20 blur-3xl z-0"></div>
        
        <div class="relative z-10 flex flex-col items-center">
            <div class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mb-6 shadow-lg shadow-green-500/20 border border-green-500/30">
                <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            
            <h2 class="text-3xl font-extrabold text-white mb-2 tracking-tight">Success!</h2>
            <p class="text-gray-300 text-lg mb-6">Your account has been funded successfully.</p>
            
            @if(ViewBag.SessionId != null)
            {
                <div class="bg-white/5 border border-white/10 rounded-lg p-4 mb-8 w-full text-left">
                    <p class="text-xs text-gray-400 uppercase tracking-wider mb-1 font-semibold">Transaction ID</p>
                    <p class="text-sm font-mono text-blue-300 truncate">@ViewBag.SessionId</p>
                </div>
            }
            
            <a href="/Client/Dashboard" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-8 rounded-xl transition-all duration-200 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/40 w-full group">
                Return to Dashboard
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>
    </div>
</div>
