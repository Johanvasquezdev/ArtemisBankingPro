@model AssignLoanViewModel
@{
    ViewData["Title"] = "Asignar préstamo";
}

<div class="admin-assignment-page">
    <div class="admin-assignment-title-row">
        <div>
            <a class="admin-assignment-back" asp-action="SelectClient">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /><path d="M9 12h10" /></svg>
                Seleccionar otro cliente
            </a>
            <h1 class="admin-assignment-title">Asignar préstamo</h1>
            <p class="admin-assignment-subtitle">Configura el monto, la tasa y el plazo del préstamo antes de desembolsarlo al cliente.</p>
        </div>
        <div class="admin-assignment-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
        </div>
    </div>

    @if (Model.HasError)
    {
        <div class="abp-alert abp-alert-danger admin-assignment-alert" role="alert">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span>@Model.Error</span>
            <button class="abp-alert-close" type="button" aria-label="Cerrar mensaje" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    @if (Model.IsHighRisk)
    {
        <div class="abp-alert abp-alert-warning admin-assignment-alert" role="alert">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
            <div>
                <p class="admin-risk-title">@Model.RiskMessage</p>
                <p class="admin-risk-details">Deuda actual: @Model.CurrentDebt.ToString("C2", new System.Globalization.CultureInfo("es-DO")) · Deuda promedio: @Model.AverageDebt.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</p>
            </div>
        </div>
    }

    <div class="admin-assignment-layout">
        <section class="abp-panel admin-assignment-form-panel">
            <div class="admin-assignment-section-heading">
                <div>
                    <p class="admin-assignment-overline">Nuevo préstamo</p>
                    <h2>Condiciones del préstamo</h2>
                </div>
                <span class="admin-assignment-status @(Model.IsHighRisk ? "admin-assignment-status-warning" : string.Empty)">@(Model.IsHighRisk ? "Revisión requerida" : "Listo para asignar")</span>
            </div>

            <form asp-action="Assign" method="post" data-loading-form data-loading-text="Asignando préstamo...">
                <input type="hidden" asp-for="ClientId" />
                <input type="hidden" asp-for="IsHighRisk" />
                <input type="hidden" asp-for="AverageDebt" />
                <input type="hidden" asp-for="CurrentDebt" />
                <input type="hidden" asp-for="RiskMessage" />
                <div asp-validation-summary="ModelOnly" class="abp-text-danger admin-assignment-validation"></div>

                <div class="admin-assignment-field admin-assignment-field-wide">
                    <label asp-for="Amount" class="abp-label">Monto a prestar</label>
                    <div class="admin-money-field">
                        <span class="admin-money-prefix">RD$</span>
                        <input asp-for="Amount" class="abp-input" inputmode="decimal" />
                    </div>
                    <p class="admin-assignment-help">Este será el monto principal desembolsado al cliente.</p>
                    <span asp-validation-for="Amount" class="abp-text-danger text-sm"></span>
                </div>

                <div class="admin-assignment-form-grid">
                    <div class="admin-assignment-field">
                        <label asp-for="AnnualInterestRate" class="abp-label">Tasa de interés anual</label>
                        <div class="admin-percent-field">
                            <input asp-for="AnnualInterestRate" class="abp-input" inputmode="decimal" />
                            <span class="admin-percent-suffix">%</span>
                        </div>
                        <p class="admin-assignment-help">Entre 0.01% y 100%.</p>
                        <span asp-validation-for="AnnualInterestRate" class="abp-text-danger text-sm"></span>
                    </div>

                    <div class="admin-assignment-field">
                        <label asp-for="TermInMonths" class="abp-label">Plazo</label>
                        <select asp-for="TermInMonths" class="abp-select">
                            @foreach (var months in new[] { 6, 12, 18, 24, 30, 36, 42, 48, 54, 60 })
                            {
                                <option value="@months">@months meses</option>
                            }
                        </select>
                        <p class="admin-assignment-help">Selecciona la duración del préstamo.</p>
                        <span asp-validation-for="TermInMonths" class="abp-text-danger text-sm"></span>
                    </div>
                </div>

                @if (Model.IsHighRisk)
                {
                    <div class="admin-risk-confirmation">
                        <input type="checkbox" asp-for="RiskConfirmed" value="true" />
                        <label asp-for="RiskConfirmed">
                            <strong>Confirmar asignación de alto riesgo</strong>
                            <span>He revisado la evaluación y autorizo continuar con este préstamo.</span>
                        </label>
                    </div>
                }

                <div class="admin-assignment-actions">
                    <button type="submit" class="abp-btn-gold">
                        <svg class="abp-icon" width="20" height="20" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                        <span data-submit-text>Asignar préstamo</span>
                    </button>
                    <a class="abp-btn-outline" asp-action="SelectClient">Cancelar</a>
                </div>
                <div class="abp-loading-status admin-assignment-loading" data-loading-status role="status" aria-live="polite">
                    <span class="abp-loading-spinner" aria-hidden="true"></span>
                    <span>Calculando cuotas y preparando el desembolso...</span>
                </div>
            </form>
        </section>

        <aside class="admin-assignment-summary">
            <div class="admin-assignment-summary-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </div>
            <p class="admin-assignment-overline">Producto seleccionado</p>
            <h2>Préstamo personal</h2>
            <p class="admin-assignment-summary-copy">El sistema calculará las cuotas con base en el monto, la tasa y el plazo elegidos.</p>
            <dl class="admin-assignment-summary-list">
                <div><dt>Plazos disponibles</dt><dd>6–60 meses</dd></div>
                <div><dt>Evaluación de riesgo</dt><dd>@(Model.IsHighRisk ? "Requerida" : "Automática")</dd></div>
            </dl>
        </aside>
    </div>
</div>
