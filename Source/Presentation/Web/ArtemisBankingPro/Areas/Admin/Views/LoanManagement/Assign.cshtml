@model AssignLoanViewModel
@{
    ViewData["Title"] = "Asignar préstamo";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">Asignar préstamo</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert abp-alert-danger abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @Model.Error
        <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

@if (Model.IsHighRisk)
{
    <div class="abp-alert abp-alert-warning abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <div>
            <p style="margin-bottom: 0.25rem;"><strong>@Model.RiskMessage</strong></p>
            <p style="margin-bottom: 0;" class="abp-font-mono text-sm">Deuda actual: @Model.CurrentDebt.ToString("C2", new System.Globalization.CultureInfo("es-DO")) — Deuda promedio: @Model.AverageDebt.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</p>
        </div>
    </div>
}

<div class="abp-panel" style="max-width: 600px;">
    <form asp-action="Assign" method="post">
        <input type="hidden" asp-for="ClientId" />
        <input type="hidden" asp-for="IsHighRisk" />
        <input type="hidden" asp-for="AverageDebt" />
        <input type="hidden" asp-for="CurrentDebt" />
        <input type="hidden" asp-for="RiskMessage" />
        <div asp-validation-summary="ModelOnly" class="abp-text-danger abp-mb-md"></div>

        <div class="abp-mb-md">
            <label asp-for="Amount" class="abp-label">Monto a prestar</label>
            <div style="position: relative;">
                <span class="prefix-symbol" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);">RD$</span>
                <input asp-for="Amount" class="abp-input abp-input-prefix" style="padding-left: 3.5rem;" />
            </div>
            <span asp-validation-for="Amount" class="abp-text-danger text-sm"></span>
        </div>

        <div class="abp-mb-md">
            <label asp-for="AnnualInterestRate" class="abp-label">Tasa de interés anual (%)</label>
            <div style="position: relative;">
                <input asp-for="AnnualInterestRate" class="abp-input" style="padding-right: 2.5rem;" />
                <span class="prefix-symbol" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%);">%</span>
            </div>
            <span asp-validation-for="AnnualInterestRate" class="abp-text-danger text-sm"></span>
        </div>

        <div class="abp-mb-md">
            <label asp-for="TermInMonths" class="abp-label">Plazo (meses)</label>
            <select asp-for="TermInMonths" class="abp-select">
                @foreach (var months in new[] { 6, 12, 18, 24, 30, 36, 42, 48, 54, 60 })
                {
                    <option value="@months">@months meses</option>
                }
            </select>
            <span asp-validation-for="TermInMonths" class="abp-text-danger text-sm"></span>
        </div>

        @if (Model.IsHighRisk)
        {
            <div class="abp-mb-md abp-flex abp-items-center abp-gap-sm">
                <input type="checkbox" asp-for="RiskConfirmed" value="true" style="width: 1.2rem; height: 1.2rem; accent-color: var(--abp-gold);" />
                <label asp-for="RiskConfirmed" class="abp-text-danger" style="font-weight: 500; cursor: pointer;">Confirmar asignación de alto riesgo</label>
            </div>
        }

        <div class="abp-flex abp-gap-sm abp-mt-lg">
            <button type="submit" class="abp-btn-gold">
                <svg class="abp-icon" width="20" height="20" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Asignar préstamo
            </button>
            <a class="abp-btn-outline" asp-action="SelectClient">Volver atrás</a>
        </div>
    </form>
</div>
