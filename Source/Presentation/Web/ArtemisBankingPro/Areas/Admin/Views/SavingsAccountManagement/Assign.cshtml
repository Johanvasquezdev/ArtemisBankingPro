@model AssignSavingsAccountViewModel
@{
    ViewData["Title"] = "Asignar cuenta de ahorro";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">Asignar cuenta de ahorro secundaria</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert abp-alert-danger abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @Model.Error
        <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<div class="abp-panel" style="max-width: 500px;">
    <form asp-action="Assign" method="post" data-loading-form data-loading-text="Creando cuenta...">
        <input type="hidden" asp-for="ClientId" />
        <div asp-validation-summary="ModelOnly" class="abp-text-danger abp-mb-md"></div>

        <div class="abp-mb-md">
            <label asp-for="InitialBalance" class="abp-label">Balance inicial</label>
            <div style="position: relative;">
                <span class="prefix-symbol" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);">RD$</span>
                <input asp-for="InitialBalance" class="abp-input abp-input-prefix" style="padding-left: 3.5rem;" />
            </div>
            <span asp-validation-for="InitialBalance" class="abp-text-danger text-sm"></span>
        </div>

        <div class="abp-flex abp-gap-sm abp-mt-lg">
            <button type="submit" class="abp-btn-gold">
                <svg class="abp-icon" width="20" height="20" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span data-submit-text>Asignar cuenta</span>
            </button>
            <a class="abp-btn-outline" asp-action="SelectClient">Volver atrás</a>
        </div>
        <div class="abp-loading-status abp-mt-md" data-loading-status role="status" aria-live="polite">
            <span class="abp-loading-spinner" aria-hidden="true"></span>
            <span>Guardando cuenta y movimiento inicial...</span>
        </div>
    </form>
</div>
