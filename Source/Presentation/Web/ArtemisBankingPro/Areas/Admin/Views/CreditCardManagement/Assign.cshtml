@model AssignCreditCardViewModel
@{
    ViewData["Title"] = "Asignar tarjeta de crédito";
}

<div class="admin-assignment-page">
    <div class="admin-assignment-title-row">
        <div>
            <a class="admin-assignment-back" asp-action="SelectClient">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /><path d="M9 12h10" /></svg>
                Seleccionar otro cliente
            </a>
            <h1 class="admin-assignment-title">Asignar tarjeta de crédito</h1>
            <p class="admin-assignment-subtitle">Define el límite disponible para que el cliente pueda utilizar su nueva tarjeta.</p>
        </div>
        <div class="admin-assignment-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M7 14h3" /></svg>
        </div>
    </div>

    @if (Model.HasError)
    {
        <div class="abp-alert abp-alert-danger admin-assignment-alert" role="alert">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span>@Model.Error</span>
            <button class="abp-alert-close" type="button" aria-label="Cerrar mensaje" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    <div class="admin-assignment-layout">
        <section class="abp-panel admin-assignment-form-panel">
            <div class="admin-assignment-section-heading">
                <div>
                    <p class="admin-assignment-overline">Nueva tarjeta</p>
                    <h2>Detalles de la asignación</h2>
                </div>
                <span class="admin-assignment-status">Activa al crear</span>
            </div>

            <form asp-action="Assign" method="post" data-loading-form data-loading-text="Asignando tarjeta...">
                <input type="hidden" asp-for="ClientId" />
                <div asp-validation-summary="ModelOnly" class="abp-text-danger admin-assignment-validation"></div>

                <div class="admin-assignment-field">
                    <label asp-for="CreditLimit" class="abp-label">Límite de crédito</label>
                    <div class="admin-money-field">
                        <span class="admin-money-prefix">RD$</span>
                        <input asp-for="CreditLimit" class="abp-input" inputmode="decimal" />
                    </div>
                    <p class="admin-assignment-help">El límite debe ser mayor que cero y define el crédito disponible inicial.</p>
                    <span asp-validation-for="CreditLimit" class="abp-text-danger text-sm"></span>
                </div>

                <div class="admin-assignment-actions">
                    <button type="submit" class="abp-btn-gold">
                        <svg class="abp-icon" width="20" height="20" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M7 14h3"/></svg>
                        <span data-submit-text>Asignar tarjeta</span>
                    </button>
                    <a class="abp-btn-outline" asp-action="SelectClient">Cancelar</a>
                </div>
                <div class="abp-loading-status admin-assignment-loading" data-loading-status role="status" aria-live="polite">
                    <span class="abp-loading-spinner" aria-hidden="true"></span>
                    <span>Generando tarjeta y configurando el límite...</span>
                </div>
            </form>
        </section>

        <aside class="admin-assignment-summary">
            <div class="admin-assignment-summary-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M7 14h3" /></svg>
            </div>
            <p class="admin-assignment-overline">Producto seleccionado</p>
            <h2>Tarjeta de crédito</h2>
            <p class="admin-assignment-summary-copy">Una línea de crédito lista para compras y operaciones autorizadas.</p>
            <dl class="admin-assignment-summary-list">
                <div><dt>Estado inicial</dt><dd>Activa</dd></div>
                <div><dt>Deuda inicial</dt><dd>RD$0.00</dd></div>
            </dl>
        </aside>
    </div>
</div>
