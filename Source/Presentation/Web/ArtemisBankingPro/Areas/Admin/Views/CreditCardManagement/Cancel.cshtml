@model CancelCreditCardViewModel
@{
    ViewData["Title"] = "Cancelar tarjeta";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">¿Está seguro que desea cancelar la tarjeta <span class="abp-font-mono">***@Model.LastFourDigits</span>?</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert abp-alert-danger abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @Model.Error
        <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

@if (Model.AmountOwed > 0)
{
    <div class="abp-alert abp-alert-warning abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Para cancelar esta tarjeta, el cliente debe saldar la totalidad de la deuda pendiente (<span class="abp-font-mono">@Model.AmountOwed.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</span>).
    </div>
}

<div class="abp-panel" style="max-width: 500px;">
    <p class="abp-text-muted abp-mb-md">Esta acción es irreversible y desactivará la tarjeta de crédito permanentemente.</p>
    
    <form asp-action="Cancel" asp-route-id="@Model.CardId" method="post">
        <div class="abp-flex abp-gap-sm">
            <button type="submit" class="abp-btn-danger" @(Model.AmountOwed > 0 ? "disabled" : "")>
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/><line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/></svg>
                Aceptar
            </button>
            <a class="abp-btn-outline" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
