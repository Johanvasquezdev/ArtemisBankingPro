@model EditCreditCardLimitViewModel
@{
    ViewData["Title"] = "Editar límite de la tarjeta";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">Editar límite - Tarjeta terminada en <span class="abp-font-mono">***@(Model.CardNumber.Length >= 4 ? Model.CardNumber[^4..] : Model.CardNumber)</span></h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert abp-alert-danger abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @Model.Error
        <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<div class="abp-panel" style="max-width: 500px;">
    <div class="abp-grid-2 abp-mb-md">
        <div>
            <div class="abp-text-muted text-sm abp-mb-xs">Límite actual</div>
            <div class="abp-font-mono" style="font-weight: 500;">@Model.CurrentCreditLimit.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</div>
        </div>
        <div>
            <div class="abp-text-muted text-sm abp-mb-xs">Monto adeudado</div>
            <div class="abp-font-mono" style="font-weight: 500;">@Model.AmountOwed.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</div>
        </div>
    </div>

    <form asp-action="EditLimit" asp-route-id="@Model.CardId" method="post">
        <input type="hidden" asp-for="CardId" />
        <input type="hidden" asp-for="CardNumber" />
        <div asp-validation-summary="ModelOnly" class="abp-text-danger abp-mb-md"></div>

        <div class="abp-mb-md">
            <label asp-for="NewCreditLimit" class="abp-label">Nuevo límite</label>
            <div style="position: relative;">
                <span class="prefix-symbol" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);">RD$</span>
                <input asp-for="NewCreditLimit" class="abp-input abp-input-prefix" style="padding-left: 3.5rem;" />
            </div>
            <span asp-validation-for="NewCreditLimit" class="abp-text-danger text-sm"></span>
        </div>

        <div class="abp-flex abp-gap-sm abp-mt-lg">
            <button type="submit" class="abp-btn-gold">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Guardar cambios
            </button>
            <a class="abp-btn-outline" asp-action="Index">Volver atrás</a>
        </div>
    </form>
</div>
