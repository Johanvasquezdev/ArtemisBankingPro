@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Resumen del Sistema";
}

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Transacciones totales -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Transacciones totales</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.TotalTransactions</p>
    </div>
    
    <!-- Transacciones de hoy -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Transacciones hoy</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.TodayTransactions</p>
    </div>

    <!-- Clientes activos -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Clientes activos</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.TotalActiveClients</p>
    </div>

    <!-- Clientes inactivos -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-100 text-red-600">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="23" y2="12"/><line x1="23" y1="8" x2="19" y2="12"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Clientes inactivos</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.TotalInactiveClients</p>
    </div>

    <!-- Préstamos vigentes -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Préstamos vigentes</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.ActiveLoans</p>
    </div>

    <!-- Tarjetas de crédito -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Tarjetas activas</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.ActiveCreditCards</p>
    </div>

    <!-- Cuentas de ahorro -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Cuentas activas</h3>
        </div>
        <p class="text-3xl font-serif font-semibold text-obsidian">@Model.TotalSavingsAccounts</p>
    </div>

    <!-- Promedio deuda -->
    <div class="bg-panel border border-obsidian/5 p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-obsidian/40">Prom. deuda/cliente</h3>
        </div>
        <p class="text-2xl font-serif font-semibold text-obsidian">@Model.AverageDebt.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</p>
    </div>
</div>
