@model EditUserViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="mb-8">
    <h1 class="text-2xl font-serif font-semibold text-obsidian tracking-tight">Editar usuario</h1>
</div>

@if (Model.HasError)
{
    <div class="flex items-center justify-between p-4 mb-6 bg-red-50 text-red-700 border border-red-200 rounded-lg shadow-sm">
        <div class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span class="text-sm font-medium">@Model.Error</span>
        </div>
        <button class="text-red-600 hover:text-red-800 focus:outline-none transition-colors" onclick="this.parentElement.remove()">×</button>
    </div>
}

<div class="bg-panel border border-obsidian/5 rounded-lg shadow-sm p-8 max-w-4xl">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Role" />
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-6"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label asp-for="FirstName" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2"></label>
                <input asp-for="FirstName" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" />
                <span asp-validation-for="FirstName" class="text-red-600 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2"></label>
                <input asp-for="LastName" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" />
                <span asp-validation-for="LastName" class="text-red-600 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label asp-for="Cedula" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2"></label>
                <input asp-for="Cedula" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors font-mono" />
                <span asp-validation-for="Cedula" class="text-red-600 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Email" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2"></label>
                <input asp-for="Email" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" />
                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="Username" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2"></label>
            <input asp-for="Username" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" />
            <span asp-validation-for="Username" class="text-red-600 text-xs mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label asp-for="Password" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2">Nueva contraseña (opcional)</label>
                <input asp-for="Password" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" />
                <span asp-validation-for="Password" class="text-red-600 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2"></label>
                <input asp-for="ConfirmPassword" class="block w-full px-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" />
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs mt-1 block"></span>
            </div>
        </div>

        @if (Model.Role == UserRole.Client)
        {
            <div class="mb-8">
                <label asp-for="AdditionalAmount" class="block text-sm font-semibold tracking-wide text-obsidian/80 mb-2">Monto adicional</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-obsidian/40 font-medium">RD$</span>
                    <input asp-for="AdditionalAmount" class="block w-full pl-12 pr-4 py-3 border border-obsidian/20 rounded-md bg-ivory/50 text-obsidian placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors font-mono" />
                </div>
            </div>
        }

        <div class="flex items-center gap-4 pt-4 border-t border-obsidian/5">
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-gold text-white text-sm font-medium rounded-md hover:bg-gold/90 transition-colors shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Guardar cambios
            </button>
            <a asp-action="Index" class="inline-flex items-center justify-center px-6 py-3 border border-obsidian/20 rounded-md text-sm font-medium text-obsidian/70 hover:text-obsidian hover:bg-ivory/50 transition-colors">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const passwordInput = document.getElementById('Password');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');
        const reqLength = document.getElementById('reqLength');
        const reqLower = document.getElementById('reqLower');
        const reqUpper = document.getElementById('reqUpper');
        const reqDigit = document.getElementById('reqDigit');
        const reqSpecial = document.getElementById('reqSpecial');

        if(passwordInput) {
            passwordInput.addEventListener('input', function() {
                const val = this.value;
                let strength = 0;
                
                const checks = {
                    length: val.length >= 8,
                    lower: /[a-z]/.test(val),
                    upper: /[A-Z]/.test(val),
                    digit: /\d/.test(val),
                    special: /[\W_]/.test(val)
                };

                if (checks.length) strength += 20;
                if (checks.lower) strength += 20;
                if (checks.upper) strength += 20;
                if (checks.digit) strength += 20;
                if (checks.special) strength += 20;

                strengthBar.style.width = strength + '%';

                if (strength === 0) {
                    strengthBar.style.backgroundColor = 'transparent';
                    strengthText.innerText = 'Fuerza: Ninguna';
                    strengthText.className = 'text-xs text-obsidian/60 mt-1 font-medium';
                } else if (strength <= 40) {
                    strengthBar.style.backgroundColor = '#ef4444';
                    strengthText.innerText = 'Fuerza: Débil';
                    strengthText.className = 'text-xs text-red-500 mt-1 font-medium';
                } else if (strength <= 80) {
                    strengthBar.style.backgroundColor = '#eab308';
                    strengthText.innerText = 'Fuerza: Media';
                    strengthText.className = 'text-xs text-yellow-500 mt-1 font-medium';
                } else {
                    strengthBar.style.backgroundColor = '#d4af37';
                    strengthText.innerText = 'Fuerza: Fuerte (Lista)';
                    strengthText.className = 'text-xs text-gold mt-1 font-medium';
                }

                const updateCheck = (el, passed) => {
                    const icon = el.querySelector('span');
                    if (passed) {
                        icon.innerHTML = '&#10004;';
                        icon.className = 'text-green-500';
                        el.classList.add('text-green-600');
                        el.classList.remove('text-obsidian/50');
                    } else {
                        icon.innerHTML = '&#10006;';
                        icon.className = 'text-red-500';
                        el.classList.remove('text-green-600');
                        el.classList.add('text-obsidian/50');
                    }
                };

                updateCheck(reqLength, checks.length);
                updateCheck(reqLower, checks.lower);
                updateCheck(reqUpper, checks.upper);
                updateCheck(reqDigit, checks.digit);
                updateCheck(reqSpecial, checks.special);
            });
        }
    </script>
}
