@model PaginatedResult<UserDto>
@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-serif font-semibold text-obsidian tracking-tight">Gestión de usuarios</h1>
    <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-gold text-white text-sm font-medium rounded-md hover:bg-gold/90 transition-colors shadow-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Crear usuario
    </a>
</div>

<div class="bg-panel border border-obsidian/5 rounded-lg shadow-sm overflow-hidden mb-8">
    <div class="p-6 border-b border-obsidian/5 bg-ivory/30">
        <form method="get" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="w-full sm:w-64">
                <label class="block text-xs font-semibold uppercase tracking-wider text-obsidian/60 mb-2">Filtrar por rol</label>                <select name="role" class="block w-full pl-3 pr-10 py-2 text-sm border border-obsidian/10 rounded-md bg-white focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" onchange="this.form.submit()">
                    <option value="">Todos los roles</option>
                    <option value="Admin">Administrador</option>
                    <option value="Cashier">Cajero</option>
                    <option value="Commerce">Comercio</option>
                    <option value="Client">Cliente</option>
                </select>
            </div>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-ivory/50 border-b border-obsidian/5">
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60">Usuario</th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60">Cédula</th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60">Nombre</th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60">Correo</th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60">Tipo</th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60">Estado</th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-obsidian/60 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-obsidian/5">
                @foreach (var user in Model.Items)
                {
                    <tr class="hover:bg-ivory/30 transition-colors">
                        <td class="px-6 py-4 text-sm font-medium text-obsidian">@user.UserName</td>
                        <td class="px-6 py-4 text-sm font-mono text-obsidian/60">@user.Cedula</td>
                        <td class="px-6 py-4 text-sm text-obsidian/80">@user.FirstName @user.LastName</td>
                        <td class="px-6 py-4 text-sm text-obsidian/60">@user.Email</td>
                        <td class="px-6 py-4 text-sm">
                            @if(user.Role == UserRole.Admin) { 
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-obsidian/10 text-obsidian">Admin</span> 
                            }
                            else if(user.Role == UserRole.Cashier) { 
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">Cajero</span> 
                            }
                            else if(user.Role == UserRole.Commerce) { 
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-700">Comercio</span> 
                            }
                            else { 
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gold/10 text-gold">Cliente</span> 
                            }
                        </td>
                        <td class="px-6 py-4 text-sm">
                            @if(user.IsActive) {
                                <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium text-green-700 bg-green-50 border border-green-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Activo
                                </span>
                            } else {
                                <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium text-red-700 bg-red-50 border border-red-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Inactivo
                                </span>
                            }
                        </td>
                        <td class="px-6 py-4 text-sm text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="inline-flex items-center px-3 py-1.5 border border-obsidian/20 rounded-md text-xs font-medium text-obsidian/70 hover:text-obsidian hover:border-obsidian/40 bg-white transition-colors">
                                    Editar
                                </a>
                                <form method="post" asp-action="ChangeStatus" asp-route-id="@user.Id" class="inline-block">
                                    <input type="hidden" name="isActive" value="@(user.IsActive ? "false" : "true")" />
                                    <button type="submit" class="inline-flex items-center px-3 py-1.5 border @(user.IsActive ? "border-red-200 text-red-600 hover:bg-red-50" : "border-green-200 text-green-600 hover:bg-green-50") rounded-md text-xs font-medium bg-white transition-colors">
                                        @(user.IsActive ? "Inactivar" : "Activar")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="p-6 border-t border-obsidian/5 bg-ivory/30 flex items-center justify-between">
            <span class="text-sm text-obsidian/60">Página @Model.Page de @Model.TotalPages</span>
            <div class="flex items-center gap-2">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index" asp-route-page="@i" class="inline-flex items-center justify-center w-8 h-8 rounded-md text-sm font-medium transition-colors @(i == Model.Page ? "bg-gold text-white border border-gold" : "bg-white text-obsidian/70 border border-obsidian/20 hover:border-obsidian/40 hover:text-obsidian")">
                        @i
                    </a>
                }
            </div>
        </div>
    }
</div>
