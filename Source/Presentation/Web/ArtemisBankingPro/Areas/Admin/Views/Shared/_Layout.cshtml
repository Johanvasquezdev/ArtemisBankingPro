<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] â€” Admin | Artemis Banking Pro</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-assignment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/abp-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArtemisBankingProApp.styles.css" asp-append-version="true" />
</head>
<body class="abp-shell abp-shell-admin bg-ivory text-obsidian font-sans antialiased min-h-screen flex relative">
    <script>
        (function() {
            try {
                var theme = localStorage.getItem('artemis-theme');
                var isDark = theme === 'light' ? false : true;
                document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
                document.body.dataset.theme = isDark ? 'dark' : 'light';
            } catch (e) {}
        })();
    </script>
    <!-- Sidebar desktop -->
    <!-- Sidebar Backdrop --><div id="sidebar-backdrop" class="fixed inset-0 bg-obsidian/60 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity opacity-0" onclick="toggleSidebar()"></div><aside id="main-sidebar" class="abp-sidebar fixed inset-y-0 left-0 z-50 flex h-screen w-64 flex-col bg-obsidian text-ivory shadow-xl transition-transform duration-300 transform -translate-x-full lg:translate-x-0">
        <div class="flex h-20 items-center border-b border-white/10 px-4">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="abp-brand-lockup block w-56 no-underline">
                <partial name="_BrandLogo" model='"light"' />
            </a>
        </div>

        <nav class="flex-1 overflow-y-auto py-6 px-3 flex flex-col gap-1">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                <svg class="w-5 h-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                Dashboard
            </a>
            <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserManagement" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                <svg class="w-5 h-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                GestiÃ³n de Usuarios
            </a>
            <a asp-area="Admin" asp-controller="LoanManagement" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "LoanManagement" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                <svg class="w-5 h-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                PrÃ©stamos
            </a>
            <a asp-area="Admin" asp-controller="CreditCardManagement" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "CreditCardManagement" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                <svg class="w-5 h-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Tarjetas de CrÃ©dito
            </a>
            <a asp-area="Admin" asp-controller="SavingsAccountManagement" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "SavingsAccountManagement" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                <svg class="w-5 h-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                Cuentas de Ahorro
            </a>
        </nav>

        <div class="p-4 border-t border-white/10">
            <a asp-area="" asp-controller="Login" asp-action="Logout" class="flex items-center justify-center gap-2 w-full px-4 py-2 text-sm font-medium text-ivory/70 hover:text-ivory hover:bg-white/5 rounded-md transition-colors">
                <svg class="w-4 h-4 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Cerrar sesiÃ³n
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex min-h-screen flex-col w-full lg:w-[calc(100%-16rem)] lg:ml-64">
        
        <header class="abp-topbar w-full bg-panel border-b border-obsidian/5 px-4 lg:px-8 py-4 flex items-center justify-between sticky top-0 z-10 shadow-sm">
            <div class="flex items-center gap-4">
                <button type="button" onclick="toggleSidebar()" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-obsidian/5 text-obsidian/70 hover:bg-gold/10 hover:text-gold lg:hidden" aria-label="Abrir menú"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg></button>
                <div>
                    <p class="text-[10px] lg:text-xs font-semibold tracking-wider text-obsidian/40 uppercase mb-0.5 lg:mb-1">Panel de Control</p>
                    <h2 class="text-lg lg:text-xl font-serif font-semibold text-obsidian tracking-tight">@ViewData["Title"]</h2>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <partial name="_ThemeToggle" />
                <div class="relative hidden sm:block">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="w-4 h-4 text-obsidian/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </div>
                    <input type="text" class="block w-48 lg:w-64 pl-10 pr-3 py-2 border border-obsidian/10 rounded-md text-sm bg-ivory/50 placeholder-obsidian/30 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors" placeholder="Buscar..." />
                </div>
            </div>
        </header>

        <main class="abp-main w-full flex-1 p-4 lg:p-8">
            @if (TempData["SuccessMessage"] is string success && !string.IsNullOrEmpty(success))
            {
                <div class="flex items-center justify-between p-4 mb-6 bg-panel text-obsidian border border-gold/30 rounded-lg shadow-sm">
                    <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gold/10 text-gold">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <span class="text-sm font-medium">@success</span>
                    </div>
                    <button class="text-obsidian/40 hover:text-gold focus:outline-none transition-colors" onclick="this.parentElement.remove()">Ã—</button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string error && !string.IsNullOrEmpty(error))
            {
                <div class="flex items-center justify-between p-4 mb-6 bg-red-50 text-red-700 border border-red-200 rounded-lg shadow-sm">
                    <div class="flex items-center gap-3">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        <span class="text-sm font-medium">@error</span>
                    </div>
                    <button class="text-red-600 hover:text-red-800 focus:outline-none transition-colors" onclick="this.parentElement.remove()">Ã—</button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/animejs/anime.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/spa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
<script>function toggleSidebar(){var s=document.getElementById("main-sidebar");var b=document.getElementById("sidebar-backdrop");if(s.classList.contains("-translate-x-full")){s.classList.remove("-translate-x-full");b.classList.remove("hidden");setTimeout(()=>b.classList.remove("opacity-0"),10);}else{s.classList.add("-translate-x-full");b.classList.add("opacity-0");setTimeout(()=>b.classList.add("hidden"),300);}}</script></body>
</html>




