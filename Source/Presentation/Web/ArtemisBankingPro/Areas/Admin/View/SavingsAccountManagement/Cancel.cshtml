@model CancelSavingsAccountViewModel
@{
    ViewData["Title"] = "Cancelar cuenta";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">¿Está seguro que desea cancelar la cuenta <span class="abp-font-mono">@Model.AccountNumber</span>?</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert abp-alert-danger abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @Model.Error
        <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

@if (Model.Balance > 0)
{
    <div class="abp-alert abp-alert-warning abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        El balance disponible (<span class="abp-font-mono">@Model.Balance.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</span>) será transferido automáticamente a la cuenta principal del cliente.
    </div>
}

<div class="abp-panel" style="max-width: 500px;">
    <p class="abp-text-muted abp-mb-md">Esta acción es irreversible y desactivará la cuenta de ahorro permanentemente.</p>
    
    <form asp-action="Cancel" asp-route-accountNumber="@Model.AccountNumber" method="post">
        <div class="abp-flex abp-gap-sm">
            <button type="submit" class="abp-btn-danger">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/><line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/></svg>
                Aceptar
            </button>
            <a class="abp-btn-outline" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
