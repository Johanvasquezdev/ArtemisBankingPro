@model PaginatedResult<SavingsAccountDto>
@{
    ViewData["Title"] = "Gestion de cuentas de ahorro";
}

<h1>Gestion de cuentas de ahorro</h1>

<a class="btn btn-success mb-3" asp-action="SelectClient">Asignar cuenta de ahorro</a>

<form method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="cedula" class="form-control" placeholder="Cedula del cliente" value="@ViewBag.CurrentCedula" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Numero de cuenta</th>
            <th>Cliente</th>
            <th>Balance</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model.Items)
        {
            <tr>
                <td>@account.AccountNumber</td>
                <td>@account.OwnerFullName</td>
                <td>@account.Balance.ToString("C2")</td>
                <td>@account.Type</td>
                <td>@account.Status</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-accountNumber="@account.AccountNumber">Ver detalles</a>
                    @if (account.Type == AccountType.Secondary && account.Status == AccountStatus.Active)
                    {
                        <a class="btn btn-sm btn-outline-danger" asp-action="Cancel" asp-route-accountNumber="@account.AccountNumber">Cancelar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>
