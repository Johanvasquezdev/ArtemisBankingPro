<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin | Artemis Banking Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArtemisBankingProApp.styles.css" asp-append-version="true" />
</head>
<body class="abp-layout-sidebar">

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="abp-sidebar">
        <div class="abp-sidebar-brand">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="abp-topbar-brand" style="text-decoration: none;">
                <span class="abp-topbar-logo">
                    <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                        <path d="M12 2 3 20h4l5-11 5 11h4L12 2Z" fill="currentColor"/>
                        <circle cx="12" cy="15.5" r="2.2" fill="currentColor"/>
                    </svg>
                </span>
                <div>
                    <span class="abp-topbar-title" style="font-size: 1rem;">Artemis <span class="accent">Banking</span></span>
                    <span class="abp-topbar-subtitle" style="font-size: 0.75rem;">Panel de Administración</span>
                </div>
            </a>
        </div>

        <nav class="abp-sidebar-nav">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                Dashboard
            </a>
            <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "UserManagement" ? "active" : "")">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Gestión de usuarios
            </a>
            <a asp-area="Admin" asp-controller="LoanManagement" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "LoanManagement" ? "active" : "")">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Préstamos
            </a>
            <a asp-area="Admin" asp-controller="CreditCardManagement" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "CreditCardManagement" ? "active" : "")">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Tarjetas de crédito
            </a>
            <a asp-area="Admin" asp-controller="SavingsAccountManagement" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "SavingsAccountManagement" ? "active" : "")">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                Cuentas de ahorro
            </a>
        </nav>

        <div class="abp-sidebar-footer">
            <a asp-area="" asp-controller="Home" asp-action="Logout" class="abp-btn-outline" style="width: 100%; text-align: center; border: none;">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Cerrar sesión
            </a>
        </div>
    </aside>

    <!-- ═══ MAIN ═══ -->
    <main class="abp-main">
        <header class="abp-content-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <span class="abp-eyebrow">Bienvenido</span>
                <h1 class="abp-heading-lg">Administrador</h1>
            </div>
            <div style="position: relative;">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--abp-text-muted);"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" class="abp-input" placeholder="Buscar..." style="padding-left: 2.5rem; width: 250px;" />
            </div>
        </header>

        <div class="abp-content-body">
            @if (TempData["SuccessMessage"] is string success && !string.IsNullOrEmpty(success))
            {
                <div class="abp-alert abp-alert-success abp-mb-md">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    @success
                    <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string error && !string.IsNullOrEmpty(error))
            {
                <div class="abp-alert abp-alert-danger abp-mb-md">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    @error
                    <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
