@model PaginatedResult<UserDto>
@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">Gestión de usuarios</h1>
    <a class="abp-btn-gold" asp-action="Create">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Crear usuario
    </a>
</div>

<div class="abp-panel abp-mb-lg">
    <form method="get" class="abp-mb-md">
        <div class="abp-grid-4">
            <div>
                <label class="abp-label">Filtrar por rol</label>
                <select name="role" class="abp-select" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    <option value="Admin">Administrador</option>
                    <option value="Cashier">Cajero</option>
                    <option value="Client">Cliente</option>
                </select>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="abp-table">
            <thead>
                <tr>
                    <th>Nombre de usuario</th>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Correo electrónico</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Items)
                {
                    <tr>
                        <td><strong>@user.UserName</strong></td>
                        <td class="abp-font-mono text-muted">@user.Cedula</td>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>
                            @if(user.Role == UserRole.Admin) { <span class="abp-badge-warning">Admin</span> }
                            else if(user.Role == UserRole.Cashier) { <span class="abp-badge-neutral">Cajero</span> }
                            else { <span class="abp-badge-success">Cliente</span> }
                        </td>
                        <td>
                            @if(user.IsActive) {
                                <span class="abp-badge-success">Activo</span>
                            } else {
                                <span class="abp-badge-danger">Inactivo</span>
                            }
                        </td>
                        <td style="text-align: right;">
                            <a class="abp-btn-outline" asp-action="Edit" asp-route-id="@user.Id" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Editar</a>
                            <form method="post" asp-action="ChangeStatus" asp-route-id="@user.Id" class="d-inline">
                                <input type="hidden" name="isActive" value="@(user.IsActive ? "false" : "true")" />
                                <button type="submit" class="abp-btn-outline @(user.IsActive ? "abp-text-danger" : "abp-text-success")" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">
                                    @(user.IsActive ? "Inactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="abp-flex abp-justify-between abp-items-center abp-mt-md">
            <span class="abp-text-muted text-sm">Página @Model.Page de @Model.TotalPages</span>
            <div class="abp-flex abp-gap-sm">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="abp-btn-outline @(i == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@i" style="padding: 0.25rem 0.75rem;">@i</a>
                }
            </div>
        </div>
    }
</div>
