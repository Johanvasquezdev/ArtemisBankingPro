@model SaveUserViewModel
@{
    ViewData["Title"] = "Crear usuario";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">Crear usuario</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert abp-alert-danger abp-mb-md">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @Model.Error
        <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<div class="abp-panel" style="max-width: 800px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="abp-text-danger abp-mb-md"></div>

        <div class="abp-grid-2">
            <div class="abp-mb-md">
                <label asp-for="FirstName" class="abp-label"></label>
                <input asp-for="FirstName" class="abp-input" />
                <span asp-validation-for="FirstName" class="abp-text-danger text-sm"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="LastName" class="abp-label"></label>
                <input asp-for="LastName" class="abp-input" />
                <span asp-validation-for="LastName" class="abp-text-danger text-sm"></span>
            </div>
        </div>

        <div class="abp-grid-2">
            <div class="abp-mb-md">
                <label asp-for="Cedula" class="abp-label"></label>
                <input asp-for="Cedula" class="abp-input" />
                <span asp-validation-for="Cedula" class="abp-text-danger text-sm"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="Email" class="abp-label"></label>
                <input asp-for="Email" class="abp-input" />
                <span asp-validation-for="Email" class="abp-text-danger text-sm"></span>
            </div>
        </div>

        <div class="abp-grid-2">
            <div class="abp-mb-md">
                <label asp-for="Username" class="abp-label"></label>
                <input asp-for="Username" class="abp-input" />
                <span asp-validation-for="Username" class="abp-text-danger text-sm"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="Role" class="abp-label"></label>
                <select asp-for="Role" class="abp-select" id="roleSelect">
                    <option value="@UserRole.Admin">Administrador</option>
                    <option value="@UserRole.Cashier">Cajero</option>
                    <option value="@UserRole.Client">Cliente</option>
                </select>
            </div>
        </div>

        <div class="abp-grid-2">
            <div class="abp-mb-md">
                <label asp-for="Password" class="abp-label"></label>
                <input asp-for="Password" class="abp-input" />
                <span asp-validation-for="Password" class="abp-text-danger text-sm"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="ConfirmPassword" class="abp-label"></label>
                <input asp-for="ConfirmPassword" class="abp-input" />
                <span asp-validation-for="ConfirmPassword" class="abp-text-danger text-sm"></span>
            </div>
        </div>

        <div class="abp-mb-md" id="initialAmountGroup">
            <label asp-for="InitialAmount" class="abp-label">Monto inicial (solo clientes)</label>
            <div style="position: relative;">
                <span class="prefix-symbol" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);">RD$</span>
                <input asp-for="InitialAmount" class="abp-input abp-input-prefix" style="padding-left: 3.5rem;" />
            </div>
        </div>

        <div class="abp-flex abp-gap-sm abp-mt-lg">
            <button type="submit" class="abp-btn-gold">
                <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Crear usuario
            </button>
            <a class="abp-btn-outline" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const roleSelect = document.getElementById('roleSelect');
        const amountGroup = document.getElementById('initialAmountGroup');
        function toggleAmount() {
            amountGroup.style.display = roleSelect.value === '@UserRole.Client' ? 'block' : 'none';
        }
        roleSelect.addEventListener('change', toggleAmount);
        toggleAmount();
    </script>
}
