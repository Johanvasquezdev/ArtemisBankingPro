@model PaginatedResult<CreditCardDto>
@{
    ViewData["Title"] = "Gestión de tarjetas de crédito";
}

<div class="abp-flex abp-items-center abp-justify-between abp-mb-md">
    <h1 class="abp-heading-lg">Gestión de tarjetas de crédito</h1>
    <a class="abp-btn-gold" asp-action="SelectClient">
        <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Asignar tarjeta de crédito
    </a>
</div>

<div class="abp-panel abp-mb-lg">
    <form method="get" class="abp-mb-md">
        <div class="abp-grid-4">
            <div>
                <label class="abp-label">Buscar por cédula</label>
                <div class="abp-flex abp-gap-sm">
                    <input type="text" name="cedula" class="abp-input" placeholder="Cédula del cliente" value="@ViewBag.CurrentCedula" />
                    <button type="submit" class="abp-btn-outline">Buscar</button>
                </div>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="abp-table">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Límite</th>
                    <th>Expiración</th>
                    <th>Adeudado</th>
                    <th>Estado</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var card in Model.Items)
                {
                    <tr>
                        <td class="abp-font-mono text-muted">**** **** **** @(card.CardNumber.Length >= 4 ? card.CardNumber[^4..] : card.CardNumber)</td>
                        <td><strong>@card.ClientFullName</strong></td>
                        <td class="abp-font-mono">@card.CreditLimit.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</td>
                        <td>@card.ExpirationDate</td>
                        <td class="abp-font-mono">@card.AmountOwed.ToString("C2", new System.Globalization.CultureInfo("es-DO"))</td>
                        <td>
                            @if(card.Status == CardStatus.Active) { <span class="abp-badge-success">Activo</span> }
                            else { <span class="abp-badge-neutral">@card.Status</span> }
                        </td>
                        <td style="text-align: right;">
                            <a class="abp-btn-outline" asp-action="Details" asp-route-id="@card.Id" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Ver detalles</a>
                            <a class="abp-btn-outline" asp-action="EditLimit" asp-route-id="@card.Id" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Editar</a>
                            @if (card.Status == CardStatus.Active)
                            {
                                <a class="abp-btn-outline abp-text-danger" asp-action="Cancel" asp-route-id="@card.Id" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Cancelar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="abp-flex abp-justify-between abp-items-center abp-mt-md">
            <span class="abp-text-muted text-sm">Página @Model.Page de @Model.TotalPages</span>
            <div class="abp-flex abp-gap-sm">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="abp-btn-outline @(i == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@i" style="padding: 0.25rem 0.75rem;">@i</a>
                }
            </div>
        </div>
    }
</div>
