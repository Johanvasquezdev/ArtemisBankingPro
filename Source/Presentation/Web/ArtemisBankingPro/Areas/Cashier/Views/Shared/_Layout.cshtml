@using System.Globalization
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro (Cajero)</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-ivory text-obsidian font-sans antialiased selection:bg-gold/20 selection:text-obsidian flex min-h-screen">

    <!-- Sidebar -->
    <aside class="fixed inset-y-0 z-10 flex w-64 flex-col border-r border-white/10 bg-obsidian text-ivory shadow-xl">
        <div class="flex h-20 items-center border-b border-white/10 px-6">
            <div class="w-52 shrink-0">
                <partial name="_BrandLogo" model='"light"' />
            </div>
        </div>

        <div class="flex-1 overflow-y-auto py-6 px-4">
            <div class="mb-4 px-3 text-xs font-semibold uppercase tracking-wider text-ivory/40">Operaciones</div>
            <nav class="space-y-1">
                @{
                    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                }
                <a href="/Cashier/CashierHome" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "Index" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    Dashboard
                </a>
                <a href="/Cashier/CashierHome/Deposit" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "Deposit" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Depósito
                </a>
                <a href="/Cashier/CashierHome/Withdraw" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "Withdraw" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Retiro
                </a>
                <a href="/Cashier/CashierHome/PayCreditCard" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "PayCreditCard" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    Pago Tarjeta
                </a>
                <a href="/Cashier/CashierHome/PayLoan" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "PayLoan" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                    Pago Préstamo
                </a>
                <a href="/Cashier/CashierHome/TransferToThirdParty" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "TransferToThirdParty" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3v18"></path>
                        <path d="M10 18l7 3 7-3"></path>
                        <path d="M7 21V3"></path>
                        <path d="M14 6L7 3 0 6"></path>
                    </svg>
                    Transferencia
                </a>
                <a href="/Cashier/CashierHome/History" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors @(action == "History" ? "bg-gold/10 text-gold" : "text-ivory/70 hover:bg-white/5 hover:text-ivory")">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Historial
                </a>
            </nav>
        </div>

        <div class="border-t border-white/10 p-4">
            <a href="/Login/Logout" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium text-ivory/70 transition-colors hover:bg-white/5 hover:text-ivory">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Cerrar Sesión
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 min-h-screen">
        <div class="max-w-7xl mx-auto px-8 py-8">
            <header class="flex items-center justify-between mb-10">
                <div>
                    <div class="text-xs font-semibold tracking-wider text-gold uppercase mb-1">Portal del Cajero</div>
                    <h1 class="text-3xl font-serif font-bold text-obsidian tracking-tight">Hola, @(ViewBag.CashierName ?? "Cajero")</h1>
                </div>
                <div class="flex items-center gap-3">
                    <partial name="_ThemeToggle" />
                    <div class="text-sm font-medium text-obsidian/60 bg-ivory/50 px-4 py-2 border border-obsidian/5 rounded-full">
                        @DateTime.Now.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("es-DO"))
                    </div>
                </div>
            </header>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="flex items-center justify-between p-4 mb-6 bg-green-50 border border-green-200 rounded-lg shadow-sm">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 flex-shrink-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        </div>
                        <div>
                            <div class="text-sm font-semibold text-green-800">Éxito</div>
                            <div class="text-sm text-green-700">@TempData["SuccessMessage"]</div>
                        </div>
                    </div>
                    <button class="text-green-600 hover:text-green-800 focus:outline-none transition-colors" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="flex items-center justify-between p-4 mb-6 bg-red-50 border border-red-200 rounded-lg shadow-sm">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center text-red-600 flex-shrink-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        </div>
                        <div>
                            <div class="text-sm font-semibold text-red-800">Error</div>
                            <div class="text-sm text-red-700">@TempData["ErrorMessage"]</div>
                        </div>
                    </div>
                    <button class="text-red-600 hover:text-red-800 focus:outline-none transition-colors" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
