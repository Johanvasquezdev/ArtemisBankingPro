@{
    ViewData["Title"] = "Transferencia a Terceros";
}

<div class="abp-panel" style="max-width: 600px; margin: 0 auto;">
    <div class="abp-flex abp-items-center abp-gap-md abp-mb-xl">
        <div style="color: var(--abp-gold); background: var(--abp-gold-bg); padding: 0.75rem; border-radius: 50%;">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
                <path d="M17 3v18"></path>
                <path d="M10 18l7 3 7-3"></path>
                <path d="M7 21V3"></path>
                <path d="M14 6L7 3 0 6"></path>
            </svg>
        </div>
        <h2 class="abp-heading-lg" style="margin: 0;">Transferencia a Terceros</h2>
    </div>

    <form asp-action="TransferToThirdParty" asp-controller="CashierHome" method="post">
        <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
        <div class="abp-mb-md">
            <label class="abp-label">Cuenta de Origen</label>
            <input type="text" name="originAccount" class="abp-input" required placeholder="Ej. 100000123" />
        </div>

        <div class="abp-mb-md">
            <label class="abp-label">Cuenta de Destino</label>
            <input type="text" name="destinationAccount" class="abp-input" required placeholder="Ej. 100000456" />
        </div>
        
        <div class="abp-mb-xl">
            <label class="abp-label">Monto a transferir</label>
            <div class="abp-input-prefix">
                <span class="prefix-symbol abp-text-muted">$</span>
                <input type="number" step="0.01" name="amount" class="abp-input abp-input-lg abp-font-mono" required placeholder="0.00" />
            </div>
        </div>

        <button type="submit" class="abp-btn-gold abp-w-full" style="width: 100%; padding: 0.85rem; font-size: 1.1rem;">
            Confirmar Transferencia
        </button>
    </form>
</div>
