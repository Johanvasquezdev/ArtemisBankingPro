@{
    ViewData["Title"] = "Depósito";
}

<div class="abp-panel" style="max-width: 600px; margin: 0 auto;">
    <div class="abp-flex abp-items-center abp-gap-md abp-mb-xl">
        <div style="color: var(--abp-success); background: rgba(40, 167, 69, 0.1); padding: 0.75rem; border-radius: 50%;">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </div>
        <h2 class="abp-heading-lg" style="margin: 0;">Procesar Depósito</h2>
    </div>

    <form asp-action="Deposit" asp-controller="CashierHome" method="post">
        <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
        <div class="abp-mb-md">
            <label class="abp-label">Número de cuenta</label>
            <input type="text" name="accountNumber" class="abp-input" required placeholder="Ej. 100000123" />
        </div>
        
        <div class="abp-mb-xl">
            <label class="abp-label">Monto a depositar</label>
            <div class="abp-input-prefix">
                <span class="prefix-symbol abp-text-muted">$</span>
                <input type="number" step="0.01" name="amount" class="abp-input abp-input-lg abp-font-mono" required placeholder="0.00" />
            </div>
        </div>

        <button type="submit" class="abp-btn-gold abp-w-full" style="width: 100%; padding: 0.85rem; font-size: 1.1rem;">
            Confirmar Depósito
        </button>
    </form>
</div>
