@{
    ViewData["Title"] = "Dashboard";
}

<div class="abp-content-header mb-8">
    <h2 class="text-2xl font-serif font-bold text-obsidian tracking-tight">Resumen General</h2>
    <p class="text-sm text-obsidian/60 mt-1">Monitorea tus ventas y actividad reciente a través de Hermes Pay.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 mb-8">
    <div class="abp-kpi-card bg-white p-6 border border-emerald-500/20 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 opacity-10">
            <svg class="w-16 h-16 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
        </div>
        <div class="text-xs font-semibold text-emerald-600 tracking-wider uppercase mb-1 relative z-10">Total Ventas</div>
        <div class="text-3xl font-sans font-bold text-obsidian relative z-10">RD$ @string.Format("{0:N2}", ViewBag.TotalSales ?? 0)</div>
    </div>
    
    <div class="abp-kpi-card bg-white p-6 border border-obsidian/10 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 opacity-5">
            <svg class="w-16 h-16 text-obsidian" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
        </div>
        <div class="text-xs font-semibold text-obsidian/50 tracking-wider uppercase mb-1 relative z-10">Transacciones Totales</div>
        <div class="text-3xl font-sans font-bold text-obsidian relative z-10">@ViewBag.TransactionsCount</div>
    </div>
</div>

<div class="abp-panel bg-white border border-obsidian/10 overflow-hidden">
    <div class="abp-panel-header px-6 pt-6 pb-4 border-b border-obsidian/5 flex justify-between items-center">
        <div>
            <h3 class="text-lg font-serif font-bold text-obsidian">Transacciones Recientes</h3>
            <p class="text-xs text-obsidian/60 mt-0.5">Últimos movimientos registrados</p>
        </div>
        <a href="/Commerce/Transactions" class="text-sm font-medium text-emerald-600 hover:text-emerald-700 transition-colors">Ver todas &rarr;</a>
    </div>
    <div class="overflow-x-auto">
        <table class="abp-table w-full text-left border-collapse">
            <thead>
                <tr class="bg-obsidian/5 border-b border-obsidian/10">
                    <th class="px-6 py-3 text-obsidian/60 font-semibold w-1/4">FECHA</th>
                    <th class="px-6 py-3 text-obsidian/60 font-semibold w-1/4">TARJETA</th>
                    <th class="px-6 py-3 text-obsidian/60 font-semibold w-1/4 text-right">MONTO</th>
                    <th class="px-6 py-3 text-obsidian/60 font-semibold w-1/4 text-center">ESTADO</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-obsidian/5 text-sm">
                @if (ViewBag.RecentTransactions != null)
                {
                    foreach (var tx in ViewBag.RecentTransactions)
                    {
                        <tr>
                            <td class="px-6 py-4 text-obsidian/80">@tx.TransactionDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="px-6 py-4 text-obsidian font-medium font-mono">**** @tx.CardLastFourDigits</td>
                            <td class="px-6 py-4 text-obsidian font-bold text-right">RD$ @string.Format("{0:N2}", tx.Amount)</td>
                            <td class="px-6 py-4 text-center">
                                @if (tx.Status == ABP.Core.Domain.Enums.TransactionStatus.Approved)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Aprobada
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Rechazada
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-obsidian/50">
                            No hay transacciones recientes.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
