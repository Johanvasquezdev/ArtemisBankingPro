@model ABP.Core.Application.ViewModels.User.SaveUserViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="abp-panel" style="animation: fadeUp 0.6s ease-out; max-width: 40rem; margin: 0 auto;">
    <div class="abp-panel-header text-center pb-2">
        <h2 class="h4 mb-1">Crea tu cuenta</h2>
        <p class="text-muted small">Únete a Artemis Banking Pro y gestiona tu patrimonio</p>
    </div>

    @if (Model.HasError)
    {
        <div class="abp-alert abp-alert-danger mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            @Model.Error
        </div>
    }

    <form asp-action="Register" method="post" class="abp-form">
        
        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label asp-for="FirstName" class="form-label">Nombre</label>
                <input asp-for="FirstName" class="form-control" placeholder="John" autofocus />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            
            <div class="col-md-6 form-group mb-3">
                <label asp-for="LastName" class="form-label">Apellido</label>
                <input asp-for="LastName" class="form-control" placeholder="Doe" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label asp-for="Cedula" class="form-label">Cédula</label>
                <input asp-for="Cedula" class="form-control" placeholder="00000000000" />
                <span asp-validation-for="Cedula" class="text-danger small"></span>
            </div>

            <div class="col-md-6 form-group mb-3">
                <label asp-for="Username" class="form-label">Usuario</label>
                <input asp-for="Username" class="form-control" placeholder="johndoe" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label">Correo Electrónico</label>
            <input asp-for="Email" class="form-control" placeholder="john.doe@example.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-4">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="col-md-6 form-group mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <button type="submit" class="abp-btn abp-btn-primary w-100 mb-4 py-2">
            Registrarme
        </button>

        <div class="text-center">
            <p class="text-muted small mb-0">
                ¿Ya tienes una cuenta? <a asp-controller="Login" asp-action="Index" class="text-primary text-decoration-none fw-medium">Inicia sesión</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
