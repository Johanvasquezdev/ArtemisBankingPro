@model ABP.Core.Application.ViewModels.User.SaveUserViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="flex min-h-screen items-center justify-center px-6 py-12">
    <div class="w-full max-w-2xl rounded-2xl border border-gold/20 bg-panel p-8 shadow-xl sm:p-10">
        <div class="mb-8 text-center">
            <div class="mx-auto mb-5 w-56">
                <partial name="_BrandLogo" model='"dark"' />
            </div>
            <h1 class="font-serif text-3xl font-semibold tracking-tight text-obsidian">Crea tu cuenta</h1>
            <p class="mt-2 text-sm text-obsidian/60">Únete a Artemis Banking Pro y gestiona tu patrimonio</p>
        </div>

        @if (Model.HasError)
        {
            <div class="mb-6 flex items-center gap-3 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
                <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>@Model.Error</span>
            </div>
        }

        <form asp-action="Register" method="post" class="space-y-5">
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="mb-2 block text-sm font-medium text-obsidian">Nombre</label>
                    <input asp-for="FirstName" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="John" autofocus />
                    <span asp-validation-for="FirstName" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="mb-2 block text-sm font-medium text-obsidian">Apellido</label>
                    <input asp-for="LastName" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="mt-1 block text-xs text-red-600"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="Cedula" class="mb-2 block text-sm font-medium text-obsidian">Cédula</label>
                    <input asp-for="Cedula" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="00000000000" />
                    <span asp-validation-for="Cedula" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Username" class="mb-2 block text-sm font-medium text-obsidian">Usuario</label>
                    <input asp-for="Username" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="johndoe" autocomplete="username" />
                    <span asp-validation-for="Username" class="mt-1 block text-xs text-red-600"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-medium text-obsidian">Correo electrónico</label>
                <input asp-for="Email" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="john.doe@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
            </div>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="Password" class="mb-2 block text-sm font-medium text-obsidian">Contraseña</label>
                    <input asp-for="Password" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="••••••••" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="mb-2 block text-sm font-medium text-obsidian">Confirmar contraseña</label>
                    <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-2.5 text-sm text-obsidian outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/20" placeholder="••••••••" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
                </div>
            </div>

            <button type="submit" class="w-full rounded-lg bg-obsidian px-4 py-3 text-sm font-semibold text-white transition hover:bg-obsidian-light focus:outline-none focus:ring-2 focus:ring-gold/40">
                Registrarme
            </button>

            <p class="text-center text-sm text-obsidian/60">
                ¿Ya tienes una cuenta?
                <a asp-controller="Login" asp-action="Index" class="font-medium text-gold underline-offset-4 hover:underline">Inicia sesión</a>
            </p>
        </form>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
