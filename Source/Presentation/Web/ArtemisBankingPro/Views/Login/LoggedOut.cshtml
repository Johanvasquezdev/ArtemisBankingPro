@{
    ViewData["Title"] = "Sesión Cerrada";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="flex min-h-screen items-center justify-center px-6 py-12">
    <div class="w-full max-w-md rounded-2xl border border-gold/20 bg-panel p-8 text-center shadow-xl sm:p-10">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-gold/10 text-gold">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h1 class="font-serif text-3xl font-semibold tracking-tight text-obsidian">Sesión cerrada</h1>
        <p class="mt-3 text-sm leading-relaxed text-obsidian/60">Ha cerrado sesión exitosamente y su información está segura. Será redirigido al inicio de sesión en unos segundos.</p>

        <div class="mb-8 mt-8 h-1 overflow-hidden rounded-full bg-ivory-dark" aria-label="Redirección en curso">
            <div id="progress-bar" class="h-full w-0 bg-gold transition-[width] duration-100"></div>
        </div>

        <a href="/Login/Index" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-gold px-4 py-3 text-sm font-semibold text-white transition hover:bg-gold-dark focus:outline-none focus:ring-2 focus:ring-gold/40">Volver al inicio de sesión</a>
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const progressBar = document.getElementById('progress-bar');
            let progress = 0;
            const duration = 5000;
            const interval = 50;
            const step = (interval / duration) * 100;

            const timer = setInterval(() => {
                progress += step;
                progressBar.style.width = `${progress}%`;

                if (progress >= 100) {
                    clearInterval(timer);
                    window.location.href = '/Login/Index';
                }
            }, interval);
        });
    </script>
}
