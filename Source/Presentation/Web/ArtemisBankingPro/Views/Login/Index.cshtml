@model ABP.Core.Application.ViewModels.User.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-login-page flex min-h-screen w-full bg-ivory">
    <!-- Left Visual (Image) -->
    <div class="hidden lg:flex relative w-1/2 overflow-hidden bg-obsidian">
        <div class="absolute inset-0">
            <img src="~/images/bank-bg.jpg" class="w-full h-full object-cover opacity-60 mix-blend-overlay" alt="Classic Bank Facade" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/40 to-transparent"></div>
        </div>
        
        <div class="absolute inset-0 p-12 flex flex-col justify-between z-10">
            <div>
                <div class="w-56">
                    <partial name="_BrandLogo" model='"light"' />
                </div>
            </div>

            <div class="max-w-md">
                <h2 class="font-serif text-4xl text-white mb-4 leading-tight">
                    Su patrimonio, protegido con estándares de élite.
                </h2>
                <div class="flex items-center gap-3 text-ivory/80 text-sm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>Cifrado de grado bancario · Verificación multifactor</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Form -->
    <div class="flex w-full lg:w-1/2 flex-col justify-center items-center p-8 lg:p-16">
        
        <div class="w-full max-w-sm">
            
            <div class="auth-login-mobile-logo lg:hidden mb-8">
                <div class="auth-login-logo-dark w-48">
                    <partial name="_BrandLogo" model='"dark"' />
                </div>
                <div class="auth-login-logo-light hidden w-48">
                    <partial name="_BrandLogo" model='"light"' />
                </div>
            </div>

            <div class="mb-10">
                <h1 class="font-serif text-3xl font-medium text-obsidian mb-2">Bienvenido de vuelta</h1>
                <p class="text-obsidian/60 text-sm">
                    Inicie sesión en su cuenta exclusiva de Artemis Banking Pro.
                </p>
            </div>

            @if (Model.HasError)
            {
                <div class="auth-login-error flex items-start gap-3 p-4 mb-6 bg-red-50 text-red-700 border border-red-100 rounded-lg text-sm">
                    <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                    <span>@Model.Error</span>
                </div>
            }

            <form asp-action="Index" method="post" class="space-y-6">
                <!-- Username -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-obsidian/40 group-focus-within:text-gold transition-colors">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <input asp-for="Username" class="auth-login-field peer w-full bg-transparent border-b border-obsidian/20 pt-6 pb-2 pl-12 pr-4 text-obsidian placeholder-transparent focus:outline-none focus:border-gold transition-colors" placeholder="Usuario" autofocus autocomplete="username" />
                    <label asp-for="Username" class="absolute left-12 top-4 text-sm text-obsidian/40 peer-placeholder-shown:top-6 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-xs peer-focus:text-gold transition-all pointer-events-none">
                        Usuario
                    </label>
                    <span asp-validation-for="Username" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Password -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-obsidian/40 group-focus-within:text-gold transition-colors">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <input asp-for="Password" class="auth-login-field peer w-full bg-transparent border-b border-obsidian/20 pt-6 pb-2 pl-12 pr-4 text-obsidian placeholder-transparent focus:outline-none focus:border-gold transition-colors" placeholder="Contraseña" autocomplete="current-password" />
                    <label asp-for="Password" class="absolute left-12 top-4 text-sm text-obsidian/40 peer-placeholder-shown:top-6 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-xs peer-focus:text-gold transition-all pointer-events-none">
                        Contraseña
                    </label>
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <div class="flex items-center">
                        <input type="checkbox" id="remember" class="w-4 h-4 rounded border-obsidian/20 text-gold focus:ring-gold/50" />
                        <label for="remember" class="ml-2 text-sm text-obsidian/60">Recordarme</label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-sm text-obsidian/60 hover:text-gold transition-colors">
                        Restablecer contraseña
                    </a>
                </div>

                <button type="submit" class="auth-login-submit w-full bg-obsidian hover:bg-obsidian-light text-white py-3 px-4 rounded-lg font-medium transition-colors shadow-sm mt-4">
                    Iniciar sesión
                </button>
            </form>

            <div class="auth-login-note mt-8 p-4 bg-[#fbf8ee] border border-gold/20 rounded-lg flex items-start gap-3">
                <svg class="mt-0.5 shrink-0 text-gold" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <div class="text-sm text-obsidian/80">
                    <strong class="block font-medium mb-1">¿Tu cuenta aún no está activa?</strong>
                    Ponte en contacto con tu asesor patrimonial personal para completar la activación de tus credenciales de acceso.
                </div>
            </div>

            <div class="mt-12 text-center text-xs text-obsidian/40">
                &copy; 2026 Artemis Banking Pro. Todos los derechos reservados.
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
