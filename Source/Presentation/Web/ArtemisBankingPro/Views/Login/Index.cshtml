@model ABP.Core.Application.ViewModels.User.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="abp-panel" style="animation: fadeUp 0.6s ease-out;">
    <div class="abp-panel-header text-center pb-2">
        <h2 class="h4 mb-1">Bienvenido de nuevo</h2>
        <p class="text-muted small">Ingresa tus credenciales para acceder a tu cuenta</p>
    </div>

    @if (Model.HasError)
    {
        <div class="abp-alert abp-alert-danger mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            @Model.Error
        </div>
    }

    <form asp-action="Index" method="post" class="abp-form">
        <div class="form-group mb-4">
            <label asp-for="Username" class="form-label">Usuario</label>
            <input asp-for="Username" class="form-control" placeholder="johndoe" autofocus autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>

        <div class="form-group mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="Password" class="form-label mb-0">Contraseña</label>
                <!-- <a href="#" class="text-muted small">¿Olvidaste tu contraseña?</a> -->
            </div>
            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button type="submit" class="abp-btn abp-btn-primary w-100 mb-4 py-2">
            Iniciar Sesión
        </button>

        <div class="text-center">
            <p class="text-muted small mb-0">
                ¿No tienes una cuenta? <a asp-controller="Account" asp-action="Register" class="text-primary text-decoration-none fw-medium">Regístrate aquí</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
