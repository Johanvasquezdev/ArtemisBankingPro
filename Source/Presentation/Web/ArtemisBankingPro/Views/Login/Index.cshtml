@model ABP.Core.Application.ViewModels.User.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-login-page flex min-h-screen w-full bg-ivory">
    <!-- Left Visual (Image) -->
    <div class="hidden lg:flex relative w-1/2 overflow-hidden bg-obsidian">
        <div class="absolute inset-0">
            <img src="~/images/bank-bg.jpg" class="w-full h-full object-cover opacity-80" alt="Classic Bank Facade" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/20 to-transparent"></div>
        </div>
        
        <div class="absolute inset-0 p-12 flex flex-col justify-between z-10">
            <div>
                <div class="w-56">
                    <partial name="_BrandLogo" model='"light"' />
                </div>
            </div>

            <div class="max-w-md">
                <h2 class="font-serif text-4xl text-white mb-4 leading-tight">
                    Su patrimonio, protegido con estándares de élite.
                </h2>
                <div class="flex items-center gap-3 text-ivory/80 text-sm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>Cifrado de grado bancario · Verificación multifactor</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Form -->
    <div class="flex w-full lg:w-1/2 flex-col justify-center items-center p-8 lg:p-16">
        
        <div class="w-full max-w-sm">
            
            <div class="auth-login-mobile-logo lg:hidden mb-8">
                <div class="auth-login-logo-dark w-48">
                    <div class="block dark:hidden"><partial name="_BrandLogo" model='"dark"' /></div><div class="hidden dark:block"><partial name="_BrandLogo" model='"light"' /></div>
                </div>
                <div class="auth-login-logo-light hidden w-48">
                    <partial name="_BrandLogo" model='"light"' />
                </div>
            </div>

            <div class="mb-10">
                <h1 class="font-serif text-3xl font-medium text-obsidian mb-2">Bienvenido de vuelta</h1>
                <p class="text-obsidian/60 text-sm">
                    Inicie sesión en su cuenta exclusiva de Artemis Banking Pro.
                </p>
            </div>

            @if (Model.HasError)
            {
                <div class="auth-login-error flex items-start gap-3 p-4 mb-6 bg-red-50 text-red-700 border border-red-100 rounded-lg text-sm">
                    <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                    <span>@Model.Error</span>
                </div>
            }

            <form asp-action="Index" method="post" class="space-y-6" data-loading-form data-loading-text="Iniciar sesión">
                <!-- Username -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-obsidian/40 group-focus-within:text-gold transition-colors">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <input asp-for="Username" class="auth-login-field peer w-full bg-transparent border-b border-obsidian/20 pt-7 pb-2 pl-12 pr-4 text-obsidian leading-6 placeholder-transparent focus:outline-none focus:border-gold transition-colors" placeholder="Usuario" autofocus autocomplete="username" />
                    <label asp-for="Username" class="absolute left-12 top-2 text-xs leading-4 text-obsidian/40 peer-focus:text-gold transition-colors pointer-events-none">
                        Usuario
                    </label>
                    <span asp-validation-for="Username" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Password -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-obsidian/40 group-focus-within:text-gold transition-colors">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <input asp-for="Password" id="LoginPassword" class="auth-login-field peer w-full bg-transparent border-b border-obsidian/20 pt-7 pb-2 pl-12 pr-10 text-obsidian leading-6 placeholder-transparent focus:outline-none focus:border-gold transition-colors" placeholder="Contraseña" autocomplete="current-password" />
                    <label asp-for="Password" class="absolute left-12 top-2 text-xs leading-4 text-obsidian/40 peer-focus:text-gold transition-colors pointer-events-none">
                        Contraseña
                    </label>
                    <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-obsidian/40 hover:text-gold transition-colors" onclick="togglePasswordVisibility('LoginPassword', this)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                    </button>
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                


                <div class="flex items-center justify-between pt-2">
                    <div class="flex items-center">
                        <input type="checkbox" id="remember" class="w-4 h-4 rounded border-obsidian/20 text-gold focus:ring-gold/50" />
                        <label for="remember" class="ml-2 text-sm text-obsidian/60">Recordarme</label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-sm text-obsidian/60 hover:text-gold transition-colors">
                        Restablecer contraseña
                    </a>
                </div>

                <button type="submit" class="auth-login-submit inline-flex w-full items-center justify-center gap-2 bg-obsidian hover:bg-obsidian-light text-white py-3 px-4 rounded-lg font-medium transition-colors shadow-sm mt-4">
                    <span data-submit-text>Iniciar sesión</span>
                </button>

            </form>

            <div class="auth-login-note mt-8 p-4 bg-[#fbf8ee] border border-gold/20 rounded-lg flex items-start gap-3">
                <svg class="mt-0.5 shrink-0 text-gold" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <div class="text-sm text-obsidian/80">
                    <strong class="block font-medium mb-1">¿Tu cuenta aún no está activa?</strong>
                    Ponte en contacto con tu asesor patrimonial personal para completar la activación de tus credenciales de acceso.
                </div>
            </div>

            <div class="mt-12 text-center text-xs text-obsidian/40">
                &copy; 2026 Artemis Banking Pro. Todos los derechos reservados.
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>`;
            } else {
                input.type = "password";
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>`;
            }
        }

        const passwordInput = document.getElementById('LoginPassword');
    </script>
}

