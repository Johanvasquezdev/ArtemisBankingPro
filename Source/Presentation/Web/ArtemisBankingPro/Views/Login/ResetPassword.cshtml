@model ABP.Core.Application.ViewModels.User.ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="mx-auto flex min-h-screen w-full max-w-md items-center px-6 py-12">
    <section class="w-full rounded-2xl border border-obsidian/10 bg-panel p-8 shadow-sm">
        <div class="block dark:hidden"><partial name="_BrandLogo" model='"dark"' /></div><div class="hidden dark:block"><partial name="_BrandLogo" model='"light"' /></div>
        <h1 class="mt-8 font-serif text-3xl text-obsidian">Crear nueva contraseña</h1>
        <p class="mt-2 text-sm text-obsidian/60">Define una contraseña nueva para recuperar tu acceso.</p>

        @if (Model.HasError)
        {
            <div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">@Model.Error</div>
        }

        <form asp-action="ResetPassword" method="post" class="mt-8 space-y-5" data-loading-form data-loading-text="Actualizando...">
            <input asp-for="Username" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="relative">
                <label asp-for="NewPassword" class="mb-2 block text-sm font-medium text-obsidian">Nueva contraseña</label>
                <div class="relative">
                    <input asp-for="NewPassword" id="NewPassword" style="max-width: 100% !important; width: 100% !important;" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-3 pr-10 text-obsidian outline-none focus:border-gold focus:ring-2 focus:ring-gold/20" autocomplete="new-password" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-obsidian/50 hover:text-obsidian" onclick="togglePasswordVisibility('NewPassword', this)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                    </button>
                </div>
                
                <div class="mt-2 h-1.5 w-full bg-obsidian/10 rounded-full overflow-hidden flex">
                    <div id="strengthBar" class="h-full bg-gold transition-all duration-300 w-0"></div>
                </div>
                <div id="strengthText" class="text-xs text-obsidian/60 mt-1 font-medium">Fuerza: Ninguna</div>
                <ul class="text-[11px] text-obsidian/50 mt-1 space-y-0.5 grid grid-cols-2">
                    <li id="reqLength" class="flex items-center gap-1"><span class="text-red-500">&#10006;</span> 8 caracteres</li>
                    <li id="reqLower" class="flex items-center gap-1"><span class="text-red-500">&#10006;</span> Minúscula</li>
                    <li id="reqUpper" class="flex items-center gap-1"><span class="text-red-500">&#10006;</span> Mayúscula</li>
                    <li id="reqDigit" class="flex items-center gap-1"><span class="text-red-500">&#10006;</span> Número</li>
                    <li id="reqSpecial" class="col-span-2 flex items-center gap-1"><span class="text-red-500">&#10006;</span> Carácter especial (@@, #, !, etc.)</li>
                </ul>

                <span asp-validation-for="NewPassword" class="mt-1 block text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="mb-2 block text-sm font-medium text-obsidian">Confirmar contraseña</label>
                <div class="relative">
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" style="max-width: 100% !important; width: 100% !important;" class="w-full rounded-lg border border-obsidian/15 bg-panel px-3 py-3 pr-10 text-obsidian outline-none focus:border-gold focus:ring-2 focus:ring-gold/20" autocomplete="new-password" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-obsidian/50 hover:text-obsidian" onclick="togglePasswordVisibility('ConfirmPassword', this)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
            </div>
            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-gold px-4 py-3 font-medium text-white transition hover:bg-gold/90">
                <span data-submit-text>Actualizar contraseña</span>
            </button>
        </form>
    </section>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>`;
            } else {
                input.type = "password";
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>`;
            }
        }

        const passwordInput = document.getElementById('NewPassword');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');
        const reqLength = document.getElementById('reqLength');
        const reqLower = document.getElementById('reqLower');
        const reqUpper = document.getElementById('reqUpper');
        const reqDigit = document.getElementById('reqDigit');
        const reqSpecial = document.getElementById('reqSpecial');

        if (passwordInput) {
            passwordInput.addEventListener('input', function() {
                const val = this.value;
                let strength = 0;
                
                const checks = {
                    length: val.length >= 8,
                    lower: /[a-z]/.test(val),
                    upper: /[A-Z]/.test(val),
                    digit: /\d/.test(val),
                    special: /[\W_]/.test(val)
                };

                const updateCheck = (el, passed) => {
                    const icon = el.querySelector('span');
                    if (passed) {
                        strength++;
                        icon.innerHTML = '&#10004;';
                        icon.className = 'text-green-500';
                        el.classList.add('text-green-600');
                        el.classList.remove('text-obsidian/50');
                    } else {
                        icon.innerHTML = '&#10006;';
                        icon.className = 'text-red-500';
                        el.classList.remove('text-green-600');
                        el.classList.add('text-obsidian/50');
                    }
                };

                updateCheck(reqLength, checks.length);
                updateCheck(reqLower, checks.lower);
                updateCheck(reqUpper, checks.upper);
                updateCheck(reqDigit, checks.digit);
                updateCheck(reqSpecial, checks.special);

                const widthPercentage = (strength / 5) * 100;
                strengthBar.style.width = widthPercentage + '%';
                
                if (strength === 0) {
                    strengthBar.className = 'h-full transition-all duration-300 bg-red-500';
                    strengthText.textContent = 'Fuerza: Ninguna';
                } else if (strength <= 2) {
                    strengthBar.className = 'h-full transition-all duration-300 bg-red-500';
                    strengthText.textContent = 'Fuerza: Débil';
                } else if (strength <= 4) {
                    strengthBar.className = 'h-full transition-all duration-300 bg-yellow-500';
                    strengthText.textContent = 'Fuerza: Buena';
                } else {
                    strengthBar.className = 'h-full transition-all duration-300 bg-green-500';
                    strengthText.textContent = 'Fuerza: Fuerte';
                }
            });
        }
    </script>
}

