@{
    ViewData["Title"] = "Registration Complete";
}

<div class="flex items-center justify-center min-h-[80vh] py-10">
    <div class="abp-glass-card w-full max-w-lg p-10 rounded-2xl shadow-2xl text-center relative overflow-hidden">
        <!-- Confetti-like elements in background -->
        <div class="absolute top-10 left-10 w-3 h-3 bg-blue-500 rounded-full animate-ping"></div>
        <div class="absolute bottom-20 right-10 w-4 h-4 bg-purple-500 rounded-full animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-2 h-2 bg-yellow-400 rounded-full animate-bounce"></div>
        <div class="absolute bottom-1/4 left-1/4 w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full bg-gradient-to-tr from-green-400/20 to-blue-500/20 blur-3xl z-0"></div>
        
        <div class="relative z-10 flex flex-col items-center">
            <div class="w-24 h-24 bg-gradient-to-br from-green-400 to-emerald-600 rounded-full flex items-center justify-center mb-8 shadow-xl shadow-green-500/30 border-4 border-gray-800">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            
            <h2 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-300 mb-4 tracking-tight">You're All Set!</h2>
            <p class="text-gray-300 text-lg mb-10 leading-relaxed px-2">Your Artemis Banking Pro account is ready and fully secured. Welcome to the future of banking.</p>
            
            <a href="/Client/Dashboard" class="group relative w-full flex justify-center py-4 px-4 border border-transparent text-lg font-bold rounded-xl text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all shadow-lg shadow-blue-500/30 overflow-hidden">
                <span class="absolute inset-0 w-full h-full -mt-1 rounded-lg opacity-30 bg-gradient-to-b from-transparent via-transparent to-black"></span>
                <span class="relative flex items-center gap-2">
                    Enter Dashboard
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
            </a>
        </div>
    </div>
</div>
