@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArtemisBankingPro</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/abp-polish.css" asp-append-version="true" />
    
    <script>
        (function() {
            try {
                var theme = localStorage.getItem('artemis-theme');
                var isDark = theme === 'light' ? false : true;
                document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
            } catch (e) {}
        })();
    </script>
</head>
<body class="abp-shell abp-auth-shell bg-ivory text-obsidian font-sans antialiased min-h-screen">

    @if (!string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "AccessDenied", StringComparison.OrdinalIgnoreCase))
    {
        <div class="fixed right-6 top-6 z-50">
            <partial name="_ThemeToggle" />
        </div>
    }

    @if (TempData["SuccessMessage"] is string success && !string.IsNullOrEmpty(success))
    {
        <div class="fixed top-4 right-4 z-50 flex items-center gap-3 p-4 bg-panel text-obsidian border border-gold/30 rounded-lg shadow-md animate-fade-in-down" role="alert">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gold/10 text-gold">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="text-sm font-medium">@success</span>
            <button class="ml-2 text-obsidian/40 hover:text-gold focus:outline-none transition-colors" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error && !string.IsNullOrEmpty(error))
    {
        <div class="fixed top-4 right-4 z-50 flex items-center gap-3 p-4 bg-red-50 text-red-700 border border-red-200 rounded-lg shadow-sm animate-fade-in-down" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span class="text-sm font-medium">@error</span>
            <button class="ml-2 text-red-500 hover:text-red-700 focus:outline-none" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    @RenderBody()

    <script src="~/lib/animejs/anime.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
