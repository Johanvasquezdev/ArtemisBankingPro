@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Artemis Banking Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArtemisBankingProApp.styles.css" asp-append-version="true" />
    
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: radial-gradient(circle at 50% 0%, #1e2433 0%, var(--bg-dark) 100%);
        }
        
        .auth-container {
            width: 100%;
            max-width: 28rem;
            padding: 1.5rem;
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 2rem;
            color: var(--text-primary);
        }

        .auth-logo svg {
            width: 48px;
            height: 48px;
            margin-bottom: 1rem;
            color: var(--accent-gold);
        }

        .auth-logo h1 {
            font-family: var(--font-serif);
            font-size: 2rem;
            font-weight: 600;
            margin: 0;
            letter-spacing: -0.02em;
        }

        .auth-logo h1 span {
            color: var(--accent-gold);
        }

        .auth-logo p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 0.5rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-logo">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 2 3 20h4l5-11 5 11h4L12 2Z" fill="currentColor"/>
                <circle cx="12" cy="15.5" r="2.2" fill="currentColor"/>
            </svg>
            <h1>Artemis <span>Banking</span></h1>
            <p>Private Wealth</p>
        </div>

        @if (TempData["SuccessMessage"] is string success && !string.IsNullOrEmpty(success))
        {
            <div class="abp-alert abp-alert-success mb-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                @success
                <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string error && !string.IsNullOrEmpty(error))
        {
            <div class="abp-alert abp-alert-danger mb-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                @error
                <button class="abp-alert-close" onclick="this.parentElement.remove()">×</button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
