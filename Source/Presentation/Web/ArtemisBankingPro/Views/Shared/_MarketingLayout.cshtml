<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Artemis Banking Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <script>
        (() => {
            const savedTheme = localStorage.getItem('artemis-theme');
            document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
        })();
    </script>
</head>
<body class="marketing-body">
    <div class="marketing-shell">
        <header class="marketing-header">
            <a href="~/" class="marketing-brand" aria-label="Inicio Artemis Banking Pro">
                <partial name="_BrandLogo" model='"dark"' />
            </a>
            <nav class="marketing-nav" aria-label="Navegación principal">
                <a href="~/Home/Client">Cliente</a>
                <a href="~/Home/HermesPay">Hermes Pay</a>
                <a href="~/Home/Administration">Administración</a>
                <a href="~/Home/Cashier">Cajero</a>
            </nav>
            <div class="marketing-actions">
                <partial name="_ThemeToggle" />
                <a asp-controller="Login" asp-action="Index" class="marketing-login">Ingresar <span aria-hidden="true">↗</span></a>
            </div>
        </header>

        <main class="marketing-main">
            @RenderBody()
        </main>

        <footer class="marketing-footer">
            <div>
                <span class="marketing-wordmark">Artemis Banking Pro</span>
                <p>Una experiencia académica de banca digital, diseñada con precisión.</p>
            </div>
            <div class="marketing-footer-links">
                <a href="~/Home/Privacy">Privacidad</a>
                <a href="~/Home/Terms">Términos</a>
                <a href="~/Home/Contact">Contacto</a>
            </div>
            <small>© @DateTime.UtcNow.Year Artemis Banking Pro</small>
        </footer>
    </div>
    <script src="~/lib/animejs/anime.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
