@{
    ViewData["Title"] = "Banca privada digital";
    Layout = "~/Views/Shared/_MarketingLayout.cshtml";
}

<section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-orbit landing-orbit-one" aria-hidden="true"></div>
    <div class="landing-orbit landing-orbit-two" aria-hidden="true"></div>
    <div class="landing-hero-copy">
        <p class="landing-eyebrow">Artemis Banking Pro <span></span> Banca privada digital</p>
        <h1 id="landing-title">El valor de cada decisión,<br /><em>bien custodiado.</em></h1>
        <p class="landing-lede">Una plataforma bancaria integral para consultar, administrar y mover productos financieros con una experiencia sobria, clara y precisa.</p>
        <div class="landing-hero-actions">
            <a asp-controller="AdvancedRegistration" asp-action="Step1" class="landing-primary">Abrir cuenta <span aria-hidden="true">→</span></a>
            <a href="#ecosistema" class="landing-text-link">Explorar el ecosistema <span aria-hidden="true">↓</span></a>
        </div>
    </div>
    <div class="landing-hero-card" aria-label="Principios de Artemis Banking Pro">
        <span class="landing-card-index">01 / 03</span>
        <span class="landing-card-kicker">Diseñado para control</span>
        <strong>Una vista, decisiones informadas.</strong>
        <p>Productos, movimientos y estado de tus operaciones siempre en contexto.</p>
        <div class="landing-card-rule"></div>
        <small>Seguridad · Trazabilidad · Claridad</small>
    </div>
</section>

<section id="ecosistema" class="landing-index" aria-labelledby="ecosystem-title">
    <div class="landing-section-heading">
        <p class="landing-eyebrow">El ecosistema</p>
        <h2 id="ecosystem-title">Un sistema, cuatro perspectivas.</h2>
        <p>Cada acceso está concebido para una responsabilidad distinta, sin perder coherencia ni visibilidad operativa.</p>
    </div>

    <div class="landing-portal-list">
        <a href="~/Home/Client" class="landing-portal landing-portal-featured">
            <span class="landing-portal-number">01</span>
            <div>
                <p>Portal personal</p>
                <h3>Cliente</h3>
            </div>
            <span class="landing-portal-copy">Cuentas, tarjetas, préstamos, beneficiarios y operaciones en una vista privada.</span>
            <span class="landing-portal-arrow" aria-hidden="true">↗</span>
        </a>
        <a href="~/Home/HermesPay" class="landing-portal">
            <span class="landing-portal-number">02</span>
            <div>
                <p>Comercios afiliados</p>
                <h3>Hermes Pay</h3>
            </div>
            <span class="landing-portal-copy">Pagos, consumos y control transaccional para comercios vinculados.</span>
            <span class="landing-portal-arrow" aria-hidden="true">↗</span>
        </a>
        <a href="~/Home/Administration" class="landing-portal">
            <span class="landing-portal-number">03</span>
            <div>
                <p>Gestión interna</p>
                <h3>Administración</h3>
            </div>
            <span class="landing-portal-copy">Usuarios, productos, comercios y operaciones bajo control por roles.</span>
            <span class="landing-portal-arrow" aria-hidden="true">↗</span>
        </a>
        <a href="~/Home/Cashier" class="landing-portal">
            <span class="landing-portal-number">04</span>
            <div>
                <p>Atención en sucursal</p>
                <h3>Cajero</h3>
            </div>
            <span class="landing-portal-copy">Depósitos, retiros, pagos y transferencias con trazabilidad operativa.</span>
            <span class="landing-portal-arrow" aria-hidden="true">↗</span>
        </a>
    </div>
</section>

<section class="landing-principles" aria-label="Principios de la plataforma">
    <div class="landing-principle-heading">
        <p class="landing-eyebrow">El estándar Artemis</p>
        <h2>Diseño que prioriza lo esencial.</h2>
    </div>
    <div class="landing-principle-grid">
        <article><span>01</span><h3>Contexto antes de confirmar</h3><p>Las acciones financieras se presentan con sus datos relevantes y estado visible.</p></article>
        <article><span>02</span><h3>Acceso definido por roles</h3><p>Cada perfil navega únicamente por los procesos que le corresponden.</p></article>
        <article><span>03</span><h3>Operaciones trazables</h3><p>Los movimientos mantienen referencias, fechas y resultados para su consulta.</p></article>
    </div>
</section>

<section class="landing-closing">
    <p class="landing-eyebrow">Artemis Banking Pro</p>
    <h2>Empieza con una identidad<br /><em>verificada.</em></h2>
    <p>Regístrate con tu cédula y completa la validación de documento para abrir tu perfil.</p>
    <a asp-controller="AdvancedRegistration" asp-action="Step1" class="landing-primary">Comenzar registro <span aria-hidden="true">→</span></a>
</section>
