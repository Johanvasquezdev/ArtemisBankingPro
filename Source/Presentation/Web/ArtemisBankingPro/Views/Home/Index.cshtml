@{
    ViewData["Title"] = "Bienvenido a Artemis";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="min-h-screen bg-gray-50 flex flex-col font-sans">
    <!-- Top Utility Nav -->
    <div class="bg-gray-100 border-b border-gray-200 hidden md:block">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 flex justify-between items-center text-xs font-semibold text-gray-500 py-2">
            <div class="flex gap-6">
                <a href="#" class="text-obsidian border-b-2 border-gold pb-2 -mb-2">Banca Personal</a>
                <a href="#" class="hover:text-obsidian transition-colors">Banca Empresarial</a>
                <a href="#" class="hover:text-obsidian transition-colors">Banca Premium</a>
                <a href="#" class="hover:text-obsidian transition-colors">Acerca de Artemis</a>
            </div>
            <div class="flex gap-4">
                <a href="#" class="hover:text-obsidian flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg> Contáctanos</a>
                <a href="#" class="hover:text-obsidian flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg> Sucursales</a>
            </div>
        </div>
    </div>

    <!-- Main Nav -->
    <nav class="w-full bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center gap-8">
                <div class="w-40">
                    <partial name="_BrandLogo" model='"light"' />
                </div>
                <!-- Main Nav Links -->
                <div class="hidden lg:flex gap-6 text-sm font-medium text-gray-700">
                    <a href="#" class="hover:text-gold transition-colors">Cuentas</a>
                    <a href="#" class="hover:text-gold transition-colors">Tarjetas de Crédito</a>
                    <a href="#" class="hover:text-gold transition-colors">Préstamos</a>
                    <a href="#" class="hover:text-gold transition-colors">Inversiones</a>
                    <a href="#" class="hover:text-gold transition-colors">Seguros</a>
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                <a asp-controller="AdvancedRegistration" asp-action="Step1" class="hidden sm:block text-sm font-bold text-obsidian underline hover:text-gold transition-colors">Hazte Cliente</a>
                <a asp-controller="Login" asp-action="Index" class="text-sm font-bold bg-gradient-to-r from-obsidian to-[#222] text-ivory px-6 py-3 rounded hover:from-gold hover:to-yellow-600 transition-colors shadow-md flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8V7a4 4 0 00-8 0v4h8z"></path></svg>
                    INGRESAR
                </a>
            </div>
        </div>
    </nav>

    <!-- Huge Hero Section like Scotiabank/WU -->
    <div class="w-full bg-obsidian text-white relative overflow-hidden flex flex-col md:flex-row">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
        
        <!-- Left Side: Massive Typography -->
        <div class="flex-1 px-6 lg:px-16 py-16 lg:py-32 relative z-10 flex flex-col justify-center border-r border-white/10">
            <span class="text-gold font-bold tracking-widest uppercase mb-4 text-sm">Finanzas Inteligentes</span>
            <h1 class="font-serif text-5xl lg:text-7xl font-bold leading-none mb-6">
                El Futuro<br/>de la Banca<br/>
                <span class="text-gold italic">Digital.</span>
            </h1>
            <p class="text-lg lg:text-xl text-gray-300 max-w-lg mb-10">
                Gestiona tu patrimonio con seguridad de clase mundial, herramientas fintech avanzadas y una interfaz premium diseñada para ti.
            </p>
            <div>
                <a asp-controller="AdvancedRegistration" asp-action="Step1" class="inline-block bg-white text-obsidian font-bold px-8 py-4 rounded-full hover:bg-gold hover:text-white transition-all shadow-lg text-lg">
                    Abre tu cuenta hoy
                </a>
            </div>
        </div>
        
        <!-- Right Side: Graphic / Callout -->
        <div class="flex-1 bg-gradient-to-br from-obsidian to-[#111] relative z-10 flex flex-col justify-center p-8 lg:p-16">
            <div class="absolute inset-0 bg-gold opacity-5"></div>
            
            <div class="max-w-md mx-auto w-full">
                <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-8 mb-6 shadow-2xl">
                    <h2 class="text-3xl font-bold font-serif mb-4 text-gold">Hermes Pay</h2>
                    <p class="text-gray-300 mb-6">La pasarela de pagos integrada para comercios. Cobra y visualiza tus ingresos al instante.</p>
                    <a asp-controller="HermesPayPublic" asp-action="Index" class="inline-flex items-center gap-2 text-white font-bold hover:text-gold transition-colors">
                        Conoce más 
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>
                </div>
                
                <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-8 shadow-2xl">
                    <h2 class="text-3xl font-bold font-serif mb-4 text-white">Tarjetas Virtuales</h2>
                    <p class="text-gray-300 mb-6">Genera tarjetas desechables para proteger tus datos en compras por internet.</p>
                    <a asp-controller="AdvancedRegistration" asp-action="Step1" class="inline-flex items-center gap-2 text-white font-bold hover:text-gold transition-colors">
                        Solicitar ahora
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Cards Section (Like Amex / Scotiabank) -->
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 w-full">
        <h2 class="text-3xl font-serif font-bold text-obsidian text-center mb-12">Más para explorar</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Card 1 -->
            <div class="bg-white rounded-2xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                <div class="h-48 bg-gray-200 relative overflow-hidden bg-obsidian">
                    <div class="absolute inset-0 opacity-20 bg-[url('/images/noise.png')] mix-blend-overlay"></div>
                    <div class="absolute inset-0 flex justify-center items-center">
                        <svg class="w-20 h-20 text-white/50 group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                </div>
                <div class="p-6">
                    <span class="text-xs font-bold text-obsidian bg-gray-100 px-2 py-1 rounded uppercase tracking-wider mb-3 inline-block">Seguridad</span>
                    <h3 class="font-bold text-xl text-obsidian mb-2">Autenticación Avanzada</h3>
                    <p class="text-gray-600 text-sm mb-4">Registro mediante OCR, verificación de dos pasos (SMS) y biometría para una protección total de tus fondos.</p>
                    <a href="#" class="text-obsidian font-bold underline hover:text-gold transition-colors">Leer más</a>
                </div>
            </div>
            
            <!-- Card 2 -->
            <div class="bg-white rounded-2xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                <div class="h-48 bg-gold relative overflow-hidden">
                    <div class="absolute inset-0 opacity-20 bg-[url('/images/noise.png')] mix-blend-overlay"></div>
                    <div class="absolute inset-0 flex justify-center items-center">
                        <svg class="w-20 h-20 text-white/70 group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                </div>
                <div class="p-6">
                    <span class="text-xs font-bold text-obsidian bg-gray-100 px-2 py-1 rounded uppercase tracking-wider mb-3 inline-block">Ahorros</span>
                    <h3 class="font-bold text-xl text-obsidian mb-2">Bolsillos Inteligentes</h3>
                    <p class="text-gray-600 text-sm mb-4">Separa tu dinero con propósitos específicos y activa el redondeo automático en cada compra.</p>
                    <a href="#" class="text-obsidian font-bold underline hover:text-gold transition-colors">Conoce cómo</a>
                </div>
            </div>
            
            <!-- Card 3 -->
            <div class="bg-white rounded-2xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl transition-shadow group">
                <div class="h-48 bg-emerald-700 relative overflow-hidden">
                    <div class="absolute inset-0 flex justify-center items-center">
                        <svg class="w-20 h-20 text-white/50 group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                    </div>
                </div>
                <div class="p-6">
                    <span class="text-xs font-bold text-obsidian bg-gray-100 px-2 py-1 rounded uppercase tracking-wider mb-3 inline-block">Servicios</span>
                    <h3 class="font-bold text-xl text-obsidian mb-2">Pagos Programados</h3>
                    <p class="text-gray-600 text-sm mb-4">No olvides ninguna factura. Programa tus pagos recurrentes y mantén tus servicios al día automáticamente.</p>
                    <a href="#" class="text-obsidian font-bold underline hover:text-gold transition-colors">Ver tutorial</a>
                </div>
            </div>
        </div>
    </div>
</div>
