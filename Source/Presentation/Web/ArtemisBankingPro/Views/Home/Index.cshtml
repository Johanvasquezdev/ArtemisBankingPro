@{
    ViewData["Title"] = "Bienvenido a Artemis";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="min-h-screen bg-obsidian flex flex-col font-sans relative overflow-hidden">
    <!-- Background Patterns -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-[url('/images/noise.png')] opacity-20 mix-blend-overlay"></div>
        <!-- Very subtle grid or dots -->
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
        <!-- Gold glow -->
        <div class="absolute -top-32 -right-32 w-[600px] h-[600px] bg-gold/10 rounded-full blur-[120px]"></div>
        <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[100px]"></div>
    </div>

    <!-- Main Nav -->
    <nav class="w-full relative z-50 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6 flex justify-between items-center">
            <div class="w-48">
                <partial name="_BrandLogo" model='"dark"' />
            </div>
            
            <div class="flex items-center gap-4">
                <a asp-controller="AdvancedRegistration" asp-action="Step1" class="hidden sm:block text-sm font-bold text-ivory hover:text-gold transition-colors">Hazte Cliente</a>
                <a asp-controller="Login" asp-action="Index" class="text-sm font-bold bg-gold text-obsidian px-6 py-2.5 rounded hover:bg-yellow-500 transition-colors shadow-lg shadow-gold/20 flex items-center gap-2">
                    INGRESAR
                </a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="w-full max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-24 relative z-10 flex-1 flex flex-col justify-center">
        <div class="max-w-3xl mb-16 text-center mx-auto">
            <span class="inline-block py-1 px-3 rounded text-gold text-xs font-bold tracking-widest uppercase mb-6 border border-gold/30 bg-gold/5">Finanzas Inteligentes</span>
            <h1 class="font-serif text-5xl lg:text-7xl font-bold text-white leading-tight mb-6 tracking-tight">
                El Futuro de la <br />
                <span class="text-gold italic">Banca Digital.</span>
            </h1>
            <p class="text-lg lg:text-xl text-gray-400 mb-10 leading-relaxed max-w-2xl mx-auto">
                Gestiona tu patrimonio con seguridad de clase mundial, herramientas fintech avanzadas y una interfaz premium diseñada para ti.
            </p>
        </div>

        <!-- Portals Grid (Restoring multi-role access) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
            <!-- Client Portal -->
            <a asp-controller="Login" asp-action="Index" class="group bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-2xl hover:border-gold/50 transition-all hover:-translate-y-1 block relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-gold/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-obsidian transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                </div>
                <h3 class="font-serif font-bold text-xl text-white mb-2 relative z-10">Portal Cliente</h3>
                <p class="text-sm text-gray-400 relative z-10">Accede a tus cuentas, tarjetas virtuales y bolsillos de ahorro.</p>
            </a>

            <!-- Hermes Pay -->
            <a asp-controller="HermesPayPublic" asp-action="Index" class="group bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-2xl hover:border-gold/50 transition-all hover:-translate-y-1 block relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-gold/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-obsidian transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="font-serif font-bold text-xl text-white mb-2 relative z-10">Hermes Pay</h3>
                <p class="text-sm text-gray-400 relative z-10">Pasarela de pagos y punto de venta para comercios afiliados.</p>
            </a>

            <!-- Admin Portal -->
            <a asp-controller="Login" asp-action="Index" class="group bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-2xl hover:border-gold/50 transition-all hover:-translate-y-1 block relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-gold/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-obsidian transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <h3 class="font-serif font-bold text-xl text-white mb-2 relative z-10">Administración</h3>
                <p class="text-sm text-gray-400 relative z-10">Panel de control central y auditoría del sistema bancario.</p>
            </a>

            <!-- Cashier Portal -->
            <a asp-controller="Login" asp-action="Index" class="group bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-2xl hover:border-gold/50 transition-all hover:-translate-y-1 block relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-gold/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-obsidian transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <h3 class="font-serif font-bold text-xl text-white mb-2 relative z-10">Cajero Físico</h3>
                <p class="text-sm text-gray-400 relative z-10">Interfaz para sucursales físicas (Depósitos y Retiros).</p>
            </a>
        </div>
    </div>
</div>
