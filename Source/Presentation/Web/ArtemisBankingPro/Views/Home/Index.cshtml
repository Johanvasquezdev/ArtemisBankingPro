@model ABP.Core.Application.ViewModels.Client.ClientHomeViewModel
@{
    ViewData["Title"] = "Inicio";
    var culture = CultureInfo.GetCultureInfo("es-DO");
    string MaskCard(string cardNumber)
        => cardNumber.Length >= 4 ? $"•••• •••• •••• {cardNumber[^4..]}" : cardNumber;
}

<div class="abp-content-header abp-flex abp-justify-between abp-items-center abp-mb-xl">
    <h1 class="abp-heading-xl abp-font-serif">Hola, @Model.ClientFullName</h1>
    <h3 class="abp-heading-md abp-text-gold abp-font-serif">Patrimonio Total: @Model.TotalBalance.ToString("C2", culture)</h3>
</div>

@if (Model.HasDelinquentLoans)
{
    <div class="abp-alert-warning abp-mb-xl">
        Tiene préstamo(s) en mora. Le recomendamos realizar el pago de sus cuotas pendientes lo antes posible.
    </div>
}

<div class="abp-grid-3 abp-mb-xl">
    <a asp-controller="Transactions" asp-action="Express" class="abp-quick-action" style="text-decoration: none;">
        <div class="qa-icon">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3v18"/><path d="M3 17l4 4 4-4"/><path d="M7 21V3"/><path d="M21 7l-4-4-4 4"/></svg>
        </div>
        <div>
            <h4 class="abp-eyebrow">Transferir</h4>
            <h3 class="abp-heading-sm">Transacción Express</h3>
        </div>
        <div class="qa-arrow">→</div>
    </a>
    <a asp-controller="Transactions" asp-action="PayCreditCard" class="abp-quick-action" style="text-decoration: none;">
        <div class="qa-icon">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <div>
            <h4 class="abp-eyebrow">Pagar</h4>
            <h3 class="abp-heading-sm">Tarjeta de Crédito</h3>
        </div>
        <div class="qa-arrow">→</div>
    </a>
    <a asp-controller="CashAdvance" asp-action="Index" class="abp-quick-action" style="text-decoration: none;">
        <div class="qa-icon">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
            <h4 class="abp-eyebrow">Retirar</h4>
            <h3 class="abp-heading-sm">Avance de Efectivo</h3>
        </div>
        <div class="qa-arrow">→</div>
    </a>
</div>

<div class="abp-mb-xl">
    <div class="abp-flex abp-items-center abp-gap-sm abp-mb-md">
        <svg class="abp-icon abp-text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        <h2 class="abp-heading-md abp-font-serif">Cuentas de Ahorro</h2>
    </div>
    @if (Model.Accounts.Count == 0)
    {
        <p class="abp-text-muted">No posee cuentas de ahorro.</p>
    }
    else
    {
        <div class="abp-grid-3">
            @foreach (var account in Model.Accounts)
            {
                <div class="abp-panel abp-panel-highlight abp-flex" style="flex-direction: column; justify-content: space-between;">
                    <div>
                        <div class="abp-flex abp-justify-between abp-items-center abp-mb-sm">
                            <span class="abp-eyebrow">Cuenta de Ahorro</span>
                            <span class="@(account.Status == AccountStatus.Active ? "abp-badge-success" : "abp-badge-neutral")">@account.Status</span>
                        </div>
                        <div class="abp-font-mono abp-text-muted abp-mb-md">@account.AccountNumber</div>
                        <div class="abp-heading-lg abp-font-serif abp-text-gold abp-mb-md">@account.Balance.ToString("C2", culture)</div>
                    </div>
                    <a asp-controller="Home" asp-action="AccountDetail" asp-route-accountNumber="@account.AccountNumber" class="abp-btn-outline abp-btn-sm" style="text-align: center; display: block;">Ver detalles</a>
                </div>
            }
        </div>
    }
</div>

<div class="abp-mb-xl">
    <div class="abp-flex abp-items-center abp-gap-sm abp-mb-md">
        <svg class="abp-icon abp-text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <h2 class="abp-heading-md abp-font-serif">Tarjetas de Crédito</h2>
    </div>
    @if (Model.CreditCards.Count == 0)
    {
        <p class="abp-text-muted">No posee tarjetas de crédito.</p>
    }
    else
    {
        <div class="abp-grid-3">
            @foreach (var card in Model.CreditCards)
            {
                <div class="abp-credit-card">
                    <div class="abp-flex abp-justify-between abp-items-center abp-mb-md">
                        <span class="abp-eyebrow" style="color: rgba(255,255,255,0.7);">Artemis Black</span>
                        <svg class="abp-icon" style="color: var(--abp-gold);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
                    </div>
                    <div class="abp-font-mono abp-mb-md" style="font-size: 1.25rem; letter-spacing: 0.1em;">@MaskCard(card.CardNumber)</div>
                    <div class="abp-grid-2 abp-gap-sm" style="font-size: 0.875rem;">
                        <div>
                            <div style="color: rgba(255,255,255,0.7); text-transform: uppercase; font-size: 0.75rem;">Límite</div>
                            <div>@card.CreditLimit.ToString("C2", culture)</div>
                        </div>
                        <div>
                            <div style="color: rgba(255,255,255,0.7); text-transform: uppercase; font-size: 0.75rem;">Deuda</div>
                            <div class="abp-text-danger">@card.AmountOwed.ToString("C2", culture)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="abp-grid-2 abp-mb-xl">
    <div>
        <div class="abp-flex abp-items-center abp-gap-sm abp-mb-md">
            <svg class="abp-icon abp-text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <h2 class="abp-heading-md abp-font-serif">Préstamos</h2>
        </div>
        @if (Model.Loans.Count == 0)
        {
            <div class="abp-panel"><p class="abp-text-muted abp-mb-0">No posee préstamos activos.</p></div>
        }
        else
        {
            <div class="abp-flex" style="flex-direction: column; gap: 1rem;">
                @foreach (var loan in Model.Loans)
                {
                    <div class="abp-panel abp-flex" style="flex-direction: column;">
                        <div class="abp-flex abp-justify-between abp-items-center abp-mb-sm">
                            <span class="abp-heading-sm abp-font-serif">Préstamo @loan.LoanNumber</span>
                            @if (loan.IsOnTime)
                            {
                                <span class="abp-badge-success">Al día</span>
                            }
                            else
                            {
                                <span class="abp-badge-danger">En mora</span>
                            }
                        </div>
                        <div class="abp-flex abp-justify-between abp-mb-xs">
                            <span class="abp-text-muted" style="font-size: 0.875rem;">Progreso: @loan.PaidInstallments de @loan.TotalInstallments cuotas</span>
                            <span class="abp-text-danger" style="font-weight: 600;">@loan.PendingAmount.ToString("C2", culture) pendientes</span>
                        </div>
                        <div class="abp-progress abp-mb-md">
                            @{
                                var progressPercent = loan.TotalInstallments > 0 ? (int)((double)loan.PaidInstallments / loan.TotalInstallments * 100) : 0;
                            }
                            <div class="abp-progress-bar" style="width: @(progressPercent)%;"></div>
                        </div>
                        <a asp-controller="Transactions" asp-action="PayLoan" class="abp-btn-outline abp-btn-sm" style="text-align: center;">Pagar Cuota</a>
                    </div>
                }
            </div>
        }
    </div>

    <div>
        <div class="abp-flex abp-items-center abp-gap-sm abp-mb-md">
            <svg class="abp-icon abp-text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h2 class="abp-heading-md abp-font-serif">Transacciones Recientes</h2>
        </div>
        <div class="abp-panel">
            @if (Model.RecentTransactions.Count == 0)
            {
                <p class="abp-text-muted abp-mb-0">Aún no tiene transacciones.</p>
            }
            else
            {
                <div class="abp-txn-list">
                    @foreach (var txn in Model.RecentTransactions)
                    {
                        var isDebit = txn.Type == TransactionType.Debit;
                        <div class="abp-txn-item abp-flex abp-justify-between abp-items-center" style="padding: 1rem 0; border-bottom: 1px solid var(--abp-border-subtle);">
                            <div>
                                <div style="font-weight: 600;">@txn.Description</div>
                                <div class="abp-text-muted" style="font-size: 0.875rem;">@txn.TransactionDate.ToString("dd/MM/yyyy HH:mm") · @txn.Beneficiary</div>
                            </div>
                            <div style="text-align: right;">
                                <div class="@(isDebit ? "abp-text-danger" : "abp-text-success")" style="font-weight: 600; font-size: 1.125rem;">
                                    @(isDebit ? "-" : "+")@txn.Amount.ToString("C2", culture)
                                </div>
                                <span class="@(txn.Status == TransactionStatus.Approved ? "abp-badge-success" : "abp-badge-danger")" style="font-size: 0.75rem; padding: 0.125rem 0.5rem;">
                                    @(txn.Status == TransactionStatus.Approved ? "Aprobada" : "Rechazada")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
