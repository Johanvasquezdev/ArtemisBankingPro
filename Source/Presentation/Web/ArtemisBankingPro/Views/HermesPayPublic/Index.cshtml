@{
    ViewData["Title"] = "Punto de Venta - Hermes Pay";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Public layout
}

<div class="bg-gray-100 min-h-screen pt-20 pb-10 flex items-center justify-center">
    <div class="max-w-7xl w-full mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-8 h-[80vh]">
        
        <!-- Left Side: POS / Commerces / Products Grid -->
        <div class="lg:col-span-8 bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden flex flex-col h-full">
            <!-- Header -->
            <div class="bg-obsidian text-ivory p-4 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    <h2 class="font-serif font-bold text-xl">Terminal de Punto de Venta</h2>
                </div>
                <div class="flex items-center gap-4 text-sm font-medium">
                    <button class="bg-white/10 hover:bg-gold hover:text-obsidian transition-colors px-3 py-1.5 rounded-lg flex items-center gap-2">
                        <span>Cerrar Turno</span>
                    </button>
                </div>
            </div>
            
            <!-- Category Filter -->
            <div class="p-4 border-b border-gray-100 flex gap-2 overflow-x-auto">
                <button class="px-4 py-2 bg-obsidian text-ivory rounded-full text-sm font-bold whitespace-nowrap shadow-md">Todos los Comercios</button>
                <button class="px-4 py-2 bg-gray-100 text-obsidian hover:bg-gray-200 rounded-full text-sm font-bold whitespace-nowrap transition-colors">Supermercados</button>
                <button class="px-4 py-2 bg-gray-100 text-obsidian hover:bg-gray-200 rounded-full text-sm font-bold whitespace-nowrap transition-colors">Tiendas Tech</button>
                <button class="px-4 py-2 bg-gray-100 text-obsidian hover:bg-gray-200 rounded-full text-sm font-bold whitespace-nowrap transition-colors">Restaurantes</button>
            </div>
            
            <!-- Products/Commerces Grid -->
            <div class="p-6 flex-1 overflow-y-auto bg-gray-50">
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <!-- Item 1 -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:border-gold hover:shadow-md cursor-pointer transition-all text-center flex flex-col items-center gap-2 group" onclick="addToCart('Supermercado Nacional', 2500)">
                        <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>
                        <h3 class="font-bold text-obsidian text-sm">Supermercado</h3>
                        <p class="text-xs text-obsidian/50">RD$ 2,500.00</p>
                    </div>
                    <!-- Item 2 -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:border-gold hover:shadow-md cursor-pointer transition-all text-center flex flex-col items-center gap-2 group" onclick="addToCart('Tienda Tech Apple', 85000)">
                        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
                        </div>
                        <h3 class="font-bold text-obsidian text-sm">Tienda Tech</h3>
                        <p class="text-xs text-obsidian/50">RD$ 85,000.00</p>
                    </div>
                    <!-- Item 3 -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:border-gold hover:shadow-md cursor-pointer transition-all text-center flex flex-col items-center gap-2 group" onclick="addToCart('Restaurante Gourmet', 4200)">
                        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"></path></svg>
                        </div>
                        <h3 class="font-bold text-obsidian text-sm">Restaurante</h3>
                        <p class="text-xs text-obsidian/50">RD$ 4,200.00</p>
                    </div>
                    <!-- Item 4 -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:border-gold hover:shadow-md cursor-pointer transition-all text-center flex flex-col items-center gap-2 group" onclick="addToCart('Farmacia Central', 850)">
                        <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                        </div>
                        <h3 class="font-bold text-obsidian text-sm">Farmacia</h3>
                        <p class="text-xs text-obsidian/50">RD$ 850.00</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Verifone / Hermes Pay Terminal -->
        <div class="lg:col-span-4 bg-[#1a1c23] rounded-3xl shadow-2xl p-6 relative flex flex-col h-full border-[6px] border-[#2c303a] overflow-hidden">
            <!-- Terminal Header -->
            <div class="flex justify-between items-center mb-6">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    <span class="text-gray-400 font-mono text-xs uppercase">Terminal #HP-4092</span>
                </div>
                <img src="/images/artemis-banking-logo-light.svg" class="h-4 opacity-50" />
            </div>

            <!-- Screen Area -->
            <div class="bg-[#e0e5ec] rounded-lg flex-1 flex flex-col border-[4px] border-[#111] shadow-inner relative overflow-hidden">
                <div class="bg-[#003366] text-white p-3 text-center text-sm font-bold shadow-md relative z-10">
                    HERMES PAY
                </div>
                
                <!-- Receipt / Cart -->
                <div class="flex-1 p-3 overflow-y-auto bg-white font-mono text-sm text-gray-800" id="receiptContainer">
                    <div class="text-center border-b border-gray-300 pb-2 mb-2 text-xs text-gray-500">
                        BIENVENIDO A<br>ARTEMIS COMMERCE
                    </div>
                    <div id="cartItems" class="space-y-2">
                        <!-- Items will appear here -->
                        <div class="text-center text-gray-400 py-4 italic text-xs">Seleccione comercios/productos para pagar</div>
                    </div>
                </div>

                <!-- Total -->
                <div class="bg-gray-100 p-3 border-t border-gray-300 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] relative z-10">
                    <div class="flex justify-between items-end mb-1">
                        <span class="font-bold text-gray-600 text-sm">TOTAL</span>
                        <span class="font-bold text-xl text-[#003366]" id="cartTotal">RD$ 0.00</span>
                    </div>
                </div>
            </div>

            <!-- Keypad Area -->
            <div class="mt-6">
                <!-- Action Buttons -->
                <button onclick="processPayment()" class="w-full bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-bold py-4 rounded-xl shadow-[0_4px_0_rgb(4,120,87)] active:shadow-[0_0px_0_rgb(4,120,87)] active:translate-y-1 transition-all flex items-center justify-center gap-2 mb-4">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    PROCESAR PAGO
                </button>
                <button onclick="clearCart()" class="w-full bg-[#333] hover:bg-[#444] text-white font-bold py-3 rounded-xl shadow-[0_4px_0_rgb(30,30,30)] active:shadow-[0_0px_0_rgb(30,30,30)] active:translate-y-1 transition-all text-sm">
                    CANCELAR / LIMPIAR
                </button>
            </div>
            
            <!-- Card Slot graphic -->
            <div class="absolute -right-1 top-20 w-3 h-32 bg-black rounded-l-md border-y border-l border-gray-600 flex items-center justify-center shadow-inner">
                <div class="w-1 h-20 bg-gray-800 rounded-full"></div>
            </div>
        </div>

    </div>
</div>

<!-- Payment Modal -->
<div id="paymentModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-obsidian/80 backdrop-blur-md p-4">
    <div class="bg-white rounded-2xl p-8 max-w-sm w-full shadow-2xl relative overflow-hidden animate-fade-in-up text-center">
        <div class="w-20 h-20 mx-auto bg-emerald-100 text-emerald-500 rounded-full flex items-center justify-center mb-6">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="font-serif text-2xl font-bold text-obsidian mb-2">Pago Aprobado</h3>
        <p class="text-obsidian/60 mb-6">Transacción procesada exitosamente mediante Hermes Pay.</p>
        <button onclick="document.getElementById('paymentModal').classList.add('hidden'); clearCart();" class="w-full bg-obsidian text-ivory hover:bg-gold py-3 rounded-lg font-semibold transition-colors">
            Cerrar
        </button>
    </div>
</div>

@section Scripts {
    <script>
        let cartTotalValue = 0;
        let cartItemsCount = 0;
        
        function addToCart(name, price) {
            const container = document.getElementById('cartItems');
            if (cartItemsCount === 0) {
                container.innerHTML = '';
            }
            
            cartItemsCount++;
            cartTotalValue += price;
            
            const itemHtml = \
                <div class="flex justify-between items-start animate-fade-in-up text-xs">
                    <span class="font-bold truncate pr-2">\</span>
                    <span class="text-right whitespace-nowrap">\$\</span>
                </div>
            \;
            
            container.insertAdjacentHTML('beforeend', itemHtml);
            document.getElementById('cartTotal').innerText = \RD$ \\;
            
            // scroll to bottom
            const receipt = document.getElementById('receiptContainer');
            receipt.scrollTop = receipt.scrollHeight;
        }
        
        function clearCart() {
            document.getElementById('cartItems').innerHTML = '<div class="text-center text-gray-400 py-4 italic text-xs">Seleccione comercios/productos para pagar</div>';
            cartTotalValue = 0;
            cartItemsCount = 0;
            document.getElementById('cartTotal').innerText = 'RD$ 0.00';
        }
        
        function processPayment() {
            if (cartItemsCount === 0) {
                alert("Seleccione un comercio o producto para procesar el pago.");
                return;
            }
            
            const btn = event.currentTarget;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<svg class="animate-spin w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> PROCESANDO...';
            btn.disabled = true;
            
            setTimeout(() => {
                document.getElementById('paymentModal').classList.remove('hidden');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }, 1500);
        }
    </script>
}
