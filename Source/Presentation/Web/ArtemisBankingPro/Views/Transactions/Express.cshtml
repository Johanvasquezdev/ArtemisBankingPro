@model ABP.Core.Application.ViewModels.Client.ExpressTransactionViewModel
@{
    ViewData["Title"] = "Transacción Express";
    var culture = CultureInfo.GetCultureInfo("es-DO");
}

<div class="abp-content-header abp-flex abp-justify-between abp-items-center abp-mb-xl">
    <h1 class="abp-heading-xl abp-font-serif">Transacción Express</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert-danger abp-mb-md">@Model.Error</div>
}

@if (Model.Options.Accounts.Count == 0)
{
    <div class="abp-alert-warning abp-mb-md">No posee cuentas de ahorro activas para realizar esta operación.</div>
}
else
{
    <div class="abp-panel" style="max-width: 600px;">
        <form asp-action="Express" method="post" data-loading-form data-loading-text="Procesando transferencia...">
            <div class="abp-mb-md">
                <label asp-for="SourceAccountNumber" class="abp-label">Cuenta de origen</label>
                <select asp-for="SourceAccountNumber" class="abp-select" asp-items="@(new SelectList(Model.Options.Accounts, "AccountNumber", "AccountNumber"))">
                    <option value="">-- Seleccione una cuenta --</option>
                </select>
                <span asp-validation-for="SourceAccountNumber" class="abp-text-danger"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="DestinationAccountNumber" class="abp-label">Cuenta destino</label>
                <input asp-for="DestinationAccountNumber" class="abp-input" placeholder="000000000" />
                <span asp-validation-for="DestinationAccountNumber" class="abp-text-danger"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="Amount" class="abp-label">Monto (RD$)</label>
                <input asp-for="Amount" class="abp-input" />
                <span asp-validation-for="Amount" class="abp-text-danger"></span>
            </div>
            <button type="submit" class="abp-btn-gold">Realizar Transacción</button>
            <div class="abp-loading-status abp-mt-sm" role="status" aria-live="polite">
                <span class="abp-loading-spinner" aria-hidden="true"></span>
                <span>Validando cuentas y procesando la transferencia...</span>
            </div>
        </form>
    </div>
}
