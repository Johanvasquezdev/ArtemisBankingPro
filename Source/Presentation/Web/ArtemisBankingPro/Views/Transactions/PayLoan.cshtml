@model ABP.Core.Application.ViewModels.Client.PayLoanViewModel
@{
    ViewData["Title"] = "Pago de Préstamo";
    var culture = CultureInfo.GetCultureInfo("es-DO");
}

<div class="abp-content-header abp-flex abp-justify-between abp-items-center abp-mb-xl">
    <h1 class="abp-heading-xl abp-font-serif">Pago de Préstamo</h1>
</div>

@if (Model.HasError)
{
    <div class="abp-alert-danger abp-mb-md">@Model.Error</div>
}

@if (Model.Options.Accounts.Count == 0)
{
    <div class="abp-alert-warning abp-mb-md">No posee cuentas de ahorro activas para realizar esta operación.</div>
}
else
{
    <div class="abp-panel" style="max-width: 600px;">
        <form asp-action="PayLoan" method="post">
            <input asp-for="IdempotencyKey" type="hidden" />
            <div class="abp-mb-md">
                <label asp-for="SourceAccountNumber" class="abp-label">Cuenta de origen</label>
                <select asp-for="SourceAccountNumber" class="abp-select" asp-items="@(new SelectList(Model.Options.Accounts, "AccountNumber", "AccountNumber"))">
                    <option value="">-- Seleccione una cuenta --</option>
                </select>
                <span asp-validation-for="SourceAccountNumber" class="abp-text-danger"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="LoanId" class="abp-label">Préstamo</label>
                <select asp-for="LoanId" class="abp-select">
                    <option value="">-- Seleccione un préstamo --</option>
                    @foreach (var loan in Model.Options.Loans)
                    {
                        <option value="@loan.Id">
                            @loan.LoanNumber — Pendiente: @loan.PendingAmount.ToString("C2", culture)
                        </option>
                    }
                </select>
                <span asp-validation-for="LoanId" class="abp-text-danger"></span>
            </div>
            <div class="abp-mb-md">
                <label asp-for="Amount" class="abp-label">Monto a pagar (RD$)</label>
                <input asp-for="Amount" class="abp-input" />
                <span asp-validation-for="Amount" class="abp-text-danger"></span>
            </div>
            <button type="submit" class="abp-btn-gold">Realizar Pago</button>
        </form>
    </div>
}
