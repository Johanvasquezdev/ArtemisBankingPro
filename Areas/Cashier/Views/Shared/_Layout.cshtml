<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="abp-bg-base">
    <div class="abp-layout-sidebar">
        <!-- Sidebar -->
        <aside class="abp-sidebar">
            <div class="abp-sidebar-brand abp-flex abp-items-center abp-gap-sm">
                <svg class="abp-icon" viewBox="0 0 24 24" width="32" height="32" style="color: var(--abp-gold);">
                    <path d="M12 2 3 20h4l5-11 5 11h4L12 2Z" fill="currentColor"/>
                    <circle cx="12" cy="15.5" r="2.2" fill="currentColor"/>
                </svg>
                <div class="abp-font-serif">
                    <div style="font-size: 1.1rem; font-weight: 700;">Artemis Banking</div>
                    <div class="abp-text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em; font-family: 'Inter', sans-serif;">PRIVATE WEALTH</div>
                </div>
            </div>

            <nav class="abp-sidebar-nav abp-mt-lg">
                <div class="abp-eyebrow abp-text-subtle" style="padding: 0 1rem; margin-bottom: 0.5rem;">Operaciones</div>
                @{
                    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                }
                <a href="/Cashier/CashierHome" class="abp-flex abp-items-center abp-gap-sm @(action == "Index" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    Dashboard
                </a>
                <a href="/Cashier/CashierHome/Deposit" class="abp-flex abp-items-center abp-gap-sm @(action == "Deposit" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Depósito
                </a>
                <a href="/Cashier/CashierHome/Withdraw" class="abp-flex abp-items-center abp-gap-sm @(action == "Withdraw" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Retiro
                </a>
                <a href="/Cashier/CashierHome/PayCreditCard" class="abp-flex abp-items-center abp-gap-sm @(action == "PayCreditCard" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    Pago Tarjeta
                </a>
                <a href="/Cashier/CashierHome/PayLoan" class="abp-flex abp-items-center abp-gap-sm @(action == "PayLoan" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                    Pago Préstamo
                </a>
                <a href="/Cashier/CashierHome/TransferToThirdParty" class="abp-flex abp-items-center abp-gap-sm @(action == "TransferToThirdParty" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3v18"></path>
                        <path d="M10 18l7 3 7-3"></path>
                        <path d="M7 21V3"></path>
                        <path d="M14 6L7 3 0 6"></path>
                    </svg>
                    Transferencia
                </a>
                <a href="/Cashier/CashierHome/History" class="abp-flex abp-items-center abp-gap-sm @(action == "History" ? "active" : "")" style="padding: 0.75rem 1rem; color: var(--abp-text-main); text-decoration: none; border-radius: 8px;">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Historial
                </a>
            </nav>

            <div class="abp-sidebar-footer abp-mt-xl" style="position: absolute; bottom: 20px; width: calc(100% - 40px);">
                <a href="/User/Login" class="abp-flex abp-items-center abp-gap-sm" style="color: var(--abp-danger); text-decoration: none; padding: 0.75rem 1rem; border-radius: 8px; background: rgba(220,53,69,0.05);">
                    <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Cerrar Sesión
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="abp-main">
            <div class="abp-content-header abp-flex abp-justify-between abp-items-center abp-mb-lg" style="padding: 2rem 2.5rem 0 2.5rem;">
                <div>
                    <div class="abp-eyebrow abp-text-gold">Portal del Cajero</div>
                    <h1 class="abp-heading-lg">Hola, @(ViewBag.CashierName ?? "Cajero")</h1>
                </div>
                <div class="abp-badge-neutral">@DateTime.Now.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("es-DO"))</div>
            </div>

            <div class="abp-content-body" style="padding: 2rem 2.5rem;">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="abp-alert-success abp-mb-md">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="abp-alert-danger abp-mb-md">
                        @TempData["ErrorMessage"]
                    </div>
                }
                
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
