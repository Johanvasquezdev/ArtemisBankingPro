@{
    ViewData["Title"] = "Historial de Operaciones";
}

<div class="abp-panel">
    <div class="abp-flex abp-items-center abp-gap-md abp-mb-xl">
        <div style="color: var(--abp-text-main); background: var(--abp-bg-base); padding: 0.75rem; border-radius: 50%;">
            <svg class="abp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
        </div>
        <h2 class="abp-heading-lg" style="margin: 0;">Historial de Operaciones</h2>
    </div>

    <div style="overflow-x: auto;">
        <table class="abp-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="text-align: left; padding: 1rem; border-bottom: 2px solid var(--abp-border-subtle);">Ref</th>
                    <th style="text-align: left; padding: 1rem; border-bottom: 2px solid var(--abp-border-subtle);">Tipo</th>
                    <th style="text-align: left; padding: 1rem; border-bottom: 2px solid var(--abp-border-subtle);">Cuenta</th>
                    <th style="text-align: right; padding: 1rem; border-bottom: 2px solid var(--abp-border-subtle);">Monto</th>
                    <th style="text-align: left; padding: 1rem; border-bottom: 2px solid var(--abp-border-subtle);">Fecha</th>
                    <th style="text-align: center; padding: 1rem; border-bottom: 2px solid var(--abp-border-subtle);">Estado</th>
                </tr>
            </thead>
            <tbody>
                <!-- Placeholder row 1 -->
                <tr>
                    <td class="abp-font-mono abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">#84201</td>
                    <td style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        <div class="abp-font-serif" style="font-weight: 600;">Depósito</div>
                    </td>
                    <td class="abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">1002348500</td>
                    <td class="abp-font-mono abp-text-success" style="text-align: right; padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle); font-weight: 600;">
                        + @((5000m).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-DO")))
                    </td>
                    <td class="abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td style="text-align: center; padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        <span class="abp-badge-success">Completado</span>
                    </td>
                </tr>
                <!-- Placeholder row 2 -->
                <tr>
                    <td class="abp-font-mono abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">#84198</td>
                    <td style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        <div class="abp-font-serif" style="font-weight: 600;">Retiro</div>
                    </td>
                    <td class="abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">1005832940</td>
                    <td class="abp-font-mono abp-text-danger" style="text-align: right; padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle); font-weight: 600;">
                        - @((1200m).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-DO")))
                    </td>
                    <td class="abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        @DateTime.Now.AddMinutes(-45).ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td style="text-align: center; padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        <span class="abp-badge-success">Completado</span>
                    </td>
                </tr>
                <!-- Placeholder row 3 -->
                <tr>
                    <td class="abp-font-mono abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">#84155</td>
                    <td style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        <div class="abp-font-serif" style="font-weight: 600;">Pago Préstamo</div>
                    </td>
                    <td class="abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">3004820100</td>
                    <td class="abp-font-mono" style="text-align: right; padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle); font-weight: 600;">
                        @((2450m).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-DO")))
                    </td>
                    <td class="abp-text-muted" style="padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        @DateTime.Now.AddHours(-2).ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td style="text-align: center; padding: 1rem; border-bottom: 1px solid var(--abp-border-subtle);">
                        <span class="abp-badge-success">Completado</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
