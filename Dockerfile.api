# Base runtime image
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files for caching restore layer
COPY ["Source/Presentation/Api/ABP.API/ABP.API.csproj", "Source/Presentation/Api/ABP.API/"]
COPY ["Source/Core/ABP.Core.Application/ABP.Core.Application.csproj", "Source/Core/ABP.Core.Application/"]
COPY ["Source/Core/ABP.Core.Domain/ABP.Core.Domain.csproj", "Source/Core/ABP.Core.Domain/"]
COPY ["Source/Infraestructure/ABP.Infraestructure.Persistence/ABP.Infraestructure.Persistence.csproj", "Source/Infraestructure/ABP.Infraestructure.Persistence/"]
COPY ["Source/Infraestructure/ABP.Infraestructure.identity/ABP.Infraestructure.identity.csproj", "Source/Infraestructure/ABP.Infraestructure.identity/"]
COPY ["Source/Infraestructure/ABP.Infraestructure.Shared/ABP.Infraestructure.Shared.csproj", "Source/Infraestructure/ABP.Infraestructure.Shared/"]

RUN dotnet restore "Source/Presentation/Api/ABP.API/ABP.API.csproj"

# Copy remaining source code
COPY . .

WORKDIR "/src/Source/Presentation/Api/ABP.API"
RUN dotnet build "ABP.API.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "ABP.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Final runtime stage
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ABP.API.dll"]
